(defpackage #:cnvrs/tests/topology
  (:use #:cl)
  (:export #:run-tests))
(defpackage #:cnvrs/tests/topology/parser (:use))
(defpackage #:cnvrs/tests/topology/lexer (:use))
(in-package #:cnvrs/tests/topology)
(defvar *checks* 0)
(defun check (value format &rest args)
  (incf *checks*)
  (unless value (error "ATN topology mismatch: ~?" format args)))
(defun fixture (name)
  (asdf:system-relative-pathname :cnvrs (concatenate 'string "test/fixtures/runtime/" name)))
(defun topology-shape (grammar vocabulary)
 (let* ((sim (cnvrs::parser-prediction-simulator grammar))
        (atn (cnvrs/runtime::simulator-atn sim))
        (table (second (cnvrs::ensure-parser-runtime grammar)))
        (types (make-hash-table)))
   (maphash (lambda (token id)
              (setf (gethash id types)
                    (if (eq token cnvrs::+end-of-input+) -1
                        (or (first (find (symbol-name token) vocabulary :key #'second :test #'string-equal))
                            (error "No vocabulary for ~s" token))))) table)
   (values
    (loop for s across (cnvrs/runtime::atn-states atn)
          for source across (cnvrs::parser-states grammar)
          collect (list (cnvrs/runtime::atn-state-kind s)
                        (cnvrs/runtime::atn-state-rule s)
                        (cnvrs/runtime::atn-state-precedence-rule-p s)
                        (cnvrs/runtime::atn-state-precedence-decision-p s)
                        (or (cnvrs/runtime::atn-state-end-state s) -1)
                        (or (cnvrs/runtime::atn-state-loop-back s) -1)
                        (or (cnvrs::state-decision source) -1)
                        (loop for e in (cnvrs/runtime::atn-state-transitions s)
                              for kind = (cnvrs/runtime::atn-transition-kind e)
                              for label = (cnvrs/runtime::atn-transition-label e)
                              collect (list kind (cnvrs/runtime::atn-transition-target e)
                                            (or (cnvrs/runtime::atn-transition-follow e) -1)
                                            (case kind
                                              (:atom (gethash label types))
                                              ((:set :not-set) (sort (mapcar (lambda(x)(gethash x types)) label) #'<))
                                              (:predicate (cdr label))
                                              (t label))
                                            (cnvrs/runtime::atn-transition-outermost-precedence-return e)
                                            (cnvrs/runtime:atn-transition-precedence e)))))
    (coerce (cnvrs/runtime::atn-decisions atn) 'list))))

(defun compare-topology (grammar name)
  (with-open-file (in (fixture name))
    (let ((vocabulary (second (read in))) (expected (second (read in)))
          (decisions (second (read in))))
      (multiple-value-bind (actual actual-decisions) (topology-shape grammar vocabulary)
        (check (= (length expected) (length actual)) "~A state count: Java ~D, Lisp ~D"
               name (length expected) (length actual))
        (check (equal decisions actual-decisions) "~A decision numbering" name)
        (loop for x in expected for y in actual for id from 0 do
          (check (equal x y) "~A state ~D~%Java: ~S~%Lisp: ~S" name id x y))))))
(defun callback (&rest arguments) (declare (ignore arguments)) t)
(defun import-grammar (name &rest options)
  (apply #'cnvrs/antlr4:parse (uiop:read-file-string (fixture name))
         :parser-package :cnvrs/tests/topology/parser :lexer-package :cnvrs/tests/topology/lexer
         options))
(defun run-tests ()
  (setf *checks* 0)
  ;; This object was constructed by COMPILE-FILE's macro expansion and restored
  ;; from immutable graph data at FASL load, with independent compiled rules.
  (let* ((file (cnvrs:ensure-compiled cnvrs/tests/topology/native:*parser*))
         (runtime (cnvrs:compile-grammar
                   (loop for rule in (cnvrs::parser-definition-rules cnvrs/tests/topology/native:*parser*)
                         collect (subseq rule 0 2))))
         (generic (cnvrs:clone-compiled runtime)))
    (compare-topology file "core-topology.sexp")
    (compare-topology runtime "core-topology.sexp")
    (check (and (cnvrs:parser-runner file) (cnvrs:parser-node-runner file))
           "file grammar has separate compiled rule runners")
    (setf (cnvrs:parser-runner generic) nil (cnvrs:parser-node-runner generic) nil)
    (dolist (tokens '((:ID :PLUS :ID :STAR :ID :SEMI)
                      (:MINUS :ID :POWER :ID :POWER :ID :SEMI)
                      (:ID :COMMA :ID :COMMA :ID :SEMI)))
      (check (equalp (cnvrs:parse file tokens) (cnvrs:parse generic tokens))
             "compiled/file and interpreted trees differ for ~S" tokens))
    (check (handler-case (progn (cnvrs:parse file '(:ID :SEMI :C) :require-eof nil) nil)
             (cnvrs:parse-error () t)) "file parser still enforces explicit EOF"))
  (let ((file (cnvrs:ensure-compiled cnvrs/tests/topology/native:*eof-set*)))
    (dolist (generic '(nil t))
      (let ((grammar (cnvrs:clone-compiled file)))
        (when generic
          (setf (cnvrs:parser-runner grammar) nil (cnvrs:parser-node-runner grammar) nil))
        (check (zerop (cnvrs:node-end (cnvrs:parse grammar nil)))
               "EOF in a token set, generic=~S" generic)
        (check (equal (cnvrs:node-children (cnvrs:parse grammar '(:A))) '(:A))
               "ordinary token in an EOF-containing set, generic=~S" generic))))
  (check (handler-case (progn (cnvrs:compile-grammar '((entry (* (cnvrs:eof))))) nil)
           (cnvrs:grammar-error () t)) "EOF-only repetition must make progress")
  (check (handler-case (progn (cnvrs:compile-grammar '((entry (cnvrs:eof :bad)))) nil)
           (cnvrs:grammar-error () t)) "EOF form takes no arguments")
  (compare-topology (cnvrs:ensure-compiled (import-grammar "Core.g4")) "core-topology.sexp")
  ;; Empty alts, labels, sets, predicates/actions, ternary and postfix recursion.
  (compare-topology
   (cnvrs:ensure-compiled
    (import-grammar "Topology.g4" :callbacks
                    (list (cons "{true}" 'callback) (cons "{System.nanoTime();}" 'callback))))
   "topology.sexp")
  (let* ((lexer (import-grammar "Java8Lexer.g4"))
         (java (cnvrs:ensure-compiled
                (import-grammar "Java8Parser.g4" :token-vocabulary (list (cons "Java8Lexer" lexer))))))
    (compare-topology java "java8-topology.sexp")
    (let ((tokens (cnvrs:lex lexer (uiop:read-file-string
                                   (asdf:system-relative-pathname :cnvrs "bench/antlr4-grammar/Bench.java")))))
      (check (= 505 (cnvrs:node-end
                     (cnvrs:parse java tokens :lexer nil
                                  :rule (find-symbol "COMPILATIONUNIT" :cnvrs/tests/topology/parser))))
             "Java 8 parses the full reference source on the native ATN")))
  (format t "~D native ATN topology checks passed.~%" *checks*)
  t)

(defpackage #:cnvrs/tests/lexer-atn (:use #:cl) (:export #:run-tests))
(defpackage #:cnvrs/tests/lexer-atn/native (:use #:cl) (:export #:*lexer*))
(in-package #:cnvrs/tests/lexer-atn/native)

;; Native equivalent of LexerParity.g4. Both runtime compilation and FASL
;; restoration are compared to the independently generated Java oracle.
(cnvrs:defparser *lexer* (:kind :lexer)
  (:KW "if")
  (:ID (+ (cnvrs:one-of "abcdefghijklmnopqrstuvwxyz")))
  (:NUMBER (+ (cnvrs:one-of "0123456789")))
  (:SHORT (and "<" (cnvrs:*? (cnvrs:any)) ">"))
  (:LONG (and "[" (cnvrs:+? (cnvrs:any)) "]"))
  (:NEST (and "{" (* (or :NEST (cnvrs:not-one-of "{}"))) "}"))
  (:GUARD (and (cnvrs:predicate cnvrs/tests/lexer-atn::callback-guard) "!" "x"
               (cnvrs:action cnvrs/tests/lexer-atn::event-1)))
  (:FALL (and "!" (cnvrs:any)))
  (:MID (and "@" (cnvrs:action cnvrs/tests/lexer-atn::event-2)
             (+ (cnvrs:one-of "abcdefghijklmnopqrstuvwxyz"))
             (cnvrs:action cnvrs/tests/lexer-atn::event-3)))
  (:PART (and "q" (cnvrs:action cnvrs/tests/lexer-atn::event-4)) :fragment t)
  (:REF (and "%" :PART (cnvrs:action cnvrs/tests/lexer-atn::event-5)))
  (:CARET (cnvrs:one-of "^a"))
  (:UNICODE (+ (cnvrs:unicode-property "L")))
  (:EMOJI "🙂")
  (:QUOTE "\"" :more t :push-mode :STR)
  (:SPACE (+ (cnvrs:one-of #.(coerce '(#\Space #\Tab #\Return #\Newline) 'string))) :skip t)
  (:COMMENT (and "//" (* (cnvrs:not-one-of (#\Return #\Newline)))) :channel :COMMENTS)
  (:EOF_TOKEN (cnvrs:eof))
  (:AFTER (and ":" (cnvrs:predicate cnvrs/tests/lexer-atn::callback-after) "y"))
  (:AFTER_FALL (and ":" (cnvrs:any)))
  (cnvrs:with-mode :STR
    (:END "\"" :type :STRING :pop-mode t)
    (:TEXT (+ (cnvrs:not-one-of "\"\\")) :more t)
    (:ESC (and "\\" (cnvrs:any)) :more t)))

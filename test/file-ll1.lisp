(defpackage #:cnvrs/tests/ll1/native
  (:use #:cl) (:import-from #:cnvrs #:? #:any #:eof #:not-token)
  (:export #:*parser*))
(in-package #:cnvrs/tests/ll1/native)
(cnvrs:defparser *parser* (:default-rule entry)
  (entry (and (or choice optional star plus multi-star multi-plus nested nullable
                  ambiguous eof-choice wild negated recursive) (eof)))
  (choice (or (and :A :B) (and :C :D)))
  (optional (and (? (or (and :A :B) (and :C :D))) :E))
  (star (and (* (and :A :B)) :E))
  (plus (and (+ (and :A :B)) :E))
  (multi-star (and (* (or (and :A :B) (and :C :D))) :E))
  (multi-plus (and (+ (or (and :A :B) (and :C :D))) :E))
  (nested (or (and sub :F) :G))
  (sub (? :H))
  (nullable (or (and empty :A) :B))
  (empty (and))
  (ambiguous (or (and :A :B) (and :A :C)))
  (eof-choice (or :A (eof)))
  (wild (or (and (any) :B) (eof)))
  (negated (or (and (not-token (:A)) :B) (and :A :C)))
  (recursive (or (and :A (? recursive)) :B)))

(defpackage #:cnvrs/tests/lexer-atn
  (:use #:cl) (:export #:run-tests))
(defpackage #:cnvrs/tests/lexer-atn/parser (:use))
(defpackage #:cnvrs/tests/lexer-atn/lexer (:use))
(in-package #:cnvrs/tests/lexer-atn)
(defvar *checks* 0)
(defvar *events* nil)
(defvar *enabled* t)
(defun check (value format &rest args)
  (incf *checks*)
  (unless value (error "Lexer Java mismatch: ~?" format args)))
(defun fixture (name)
  (asdf:system-relative-pathname :cnvrs (concatenate 'string "test/fixtures/antlr-runtime/" name)))
(defun callback-guard (source at) (declare (ignore source at)) *enabled*)
(defun callback-event (number source at)
  (declare (ignore source))
  (push (list number at (cnvrs:lexer-state-line cnvrs:*lexer-state*)
              (cnvrs:lexer-state-column cnvrs:*lexer-state*)) *events*))
(defun callback-after (source at) (callback-event 6 source at) *enabled*)
(defun event-1 (s p) (callback-event 1 s p))
(defun event-2 (s p) (callback-event 2 s p))
(defun event-3 (s p) (callback-event 3 s p))
(defun event-4 (s p) (callback-event 4 s p))
(defun event-5 (s p) (callback-event 5 s p))
(defun symbolic-name (symbol)
  (cond ((eq symbol :default) "DEFAULT_MODE") ((eq symbol cnvrs:+end-of-input+) "EOF")
        ((symbolp symbol) (symbol-name symbol)) (t symbol)))
(defun action-shape (a)
  (if (member (first a) '(:type :channel :mode :push-mode))
      (list (first a) (if (and (eq (first a) :channel) (eq (second a) :default))
                         "DEFAULT_TOKEN_CHANNEL" (symbolic-name (second a)))) a))
(defun atn-shape (lexer)
  (let* ((sim (cnvrs::compiled-lexer-runtime lexer))
         (atn (cnvrs/antlr-runtime::lexer-simulator-atn sim)))
    (values
     (loop for s across (cnvrs/antlr-runtime::atn-states atn)
           for source across (cnvrs:compiled-lexer-states lexer)
           collect (list (cnvrs/antlr-runtime::atn-state-kind s) (cnvrs/antlr-runtime::atn-state-rule s)
                         (cnvrs/antlr-runtime::atn-state-non-greedy-p s)
                         (or (cnvrs/antlr-runtime::atn-state-end-state s) -1)
                         (or (cnvrs/antlr-runtime::atn-state-loop-back s) -1)
                         (or (cnvrs::state-decision source) -1)
                         (loop for e in (cnvrs/antlr-runtime::atn-state-transitions s)
                               collect (list (cnvrs/antlr-runtime::atn-transition-kind e)
                                             (cnvrs/antlr-runtime::atn-transition-target e)
                                             (or (cnvrs/antlr-runtime::atn-transition-follow e) -1)
                                             (cnvrs/antlr-runtime::atn-transition-label e)))))
     (coerce (cnvrs/antlr-runtime::atn-decisions atn) 'list)
     (coerce (cnvrs/antlr-runtime::atn-mode-starts atn) 'list)
     (map 'list #'action-shape (cnvrs/antlr-runtime::atn-lexer-actions atn)))))
(defun dfa-shape (lexer)
  (map 'list
       (lambda (dfa)
         (list (cnvrs/antlr-runtime::lexer-dfa-state-count dfa)
               (loop for bucket being the hash-values of (cnvrs/antlr-runtime::lexer-dfa-states dfa)
                     sum (loop for state in bucket sum
                           (count-if #'identity (cnvrs/antlr-runtime::lexer-dfa-state-edges state))))))
       (cnvrs/antlr-runtime::lexer-simulator-dfas (cnvrs::compiled-lexer-runtime lexer))))
(defun token-shape (token)
  (list (symbolic-name (cnvrs:lexeme-kind token)) (cnvrs:lexeme-text token)
        (cnvrs:lexeme-start token) (cnvrs:lexeme-end token)
        (cnvrs:lexeme-line token) (cnvrs:lexeme-column token)
        (if (eq (cnvrs:lexeme-channel token) :default) "DEFAULT_TOKEN_CHANNEL"
            (symbol-name (cnvrs:lexeme-channel token)))))
(defun compare-oracle (lexer name)
  (with-open-file (in (fixture name))
    (let ((vocabulary (second (read in))) (states (second (read in)))
          (decisions (second (read in))) (modes (second (read in)))
          (actions (second (read in))) (types (second (read in)))
          (tokens nil) (errors nil))
      (check (equal types
                    (map 'list (lambda (kind)
                                 (or (first (find (symbol-name kind) vocabulary :key #'second :test #'string-equal)) 0))
                         (cnvrs:compiled-lexer-kinds lexer)))
             "~A rule token types" name)
      (multiple-value-bind (actual actual-decisions actual-modes actual-actions) (atn-shape lexer)
        (check (= (length states) (length actual)) "~A states Java ~D native ~D" name (length states) (length actual))
        (loop for a in actual for e in states for id from 0 do
          (check (equal a e) "~A ATN state ~D~%Java ~S~%Lisp ~S" name id e a))
        (check (equal decisions actual-decisions) "~A decisions" name)
        (check (equal modes actual-modes) "~A modes" name)
        (check (equal actions actual-actions) "~A actions~%Java ~S~%Lisp ~S" name actions actual-actions))
      (loop for form = (read in nil nil) while form do
        (case (first form)
          (:input
           (setf *enabled* (third form) *events* nil tokens nil errors nil)
           (let ((state (cnvrs:make-lexer-state lexer (second form))))
             (handler-bind ((cnvrs:lexical-error
                              (lambda (e) (push (list (cnvrs:lexical-error-position e)
                                                     (cnvrs:lexical-error-failed-position e)
                                                     (cnvrs:lexical-error-line e) (cnvrs:lexical-error-column e)) errors))))
               (loop for token = (cnvrs:lexer-next-token state :recover t) do
                 (push (token-shape token) tokens)
                 (when (eq (cnvrs:lexeme-kind token) cnvrs:+end-of-input+) (return))))
           (setf tokens (nreverse tokens) errors (nreverse errors))))
          (:token (let ((actual (pop tokens)))
                    (setf (second form) (string-upcase (second form)))
                    (check (equal actual (rest form)) "~A token Java ~S Lisp ~S" name (rest form) actual)))
          (:errors (check (equal errors (second form)) "~A errors Java ~S Lisp ~S" name (second form) errors))
          (:events (check (equal (reverse *events*) (second form)) "~A events Java ~S Lisp ~S" name (second form) (reverse *events*)))
          (:dfa (check (equal (dfa-shape lexer) (second form)) "~A DFAs~%Java ~S~%Lisp ~S" name (second form) (dfa-shape lexer))))))))
(defun import-lexer (name &rest options)
  (cnvrs:ensure-compiled
   (apply #'cnvrs/antlr4:parse (uiop:read-file-string (fixture name))
          :parser-package :cnvrs/tests/lexer-atn/parser :lexer-package :cnvrs/tests/lexer-atn/lexer options)))
(defun adaptation-checks ()
  (let ((lexer (cnvrs:compile-lexer '((:word "abc")))))
    (check (handler-case (progn (cnvrs:lex lexer "ab?abc") nil)
             (cnvrs:lexical-error (e)
               (and (= 0 (cnvrs:lexical-error-position e))
                    (= 2 (cnvrs:lexical-error-failed-position e))))) "strict failure positions")
    (let ((tokens (handler-bind ((cnvrs:lexical-error
                                  (lambda (e) (declare (ignore e)) (invoke-restart 'cnvrs:skip-character))))
                    (cnvrs:lex lexer "ab?abc"))))
      (check (and (= 1 (length tokens)) (= 3 (cnvrs:lexeme-start (aref tokens 0))))
             "condition restart discards failed prefix and offending character")))
  (let* ((callback (lambda (source position)
                     (declare (ignore source))
                     (check (= position 1) "custom action cursor")
                     (setf (cnvrs:lexer-state-type cnvrs:*lexer-state*) :changed
                           (cnvrs:lexer-state-text cnvrs:*lexer-state*) "replacement"
                           (cnvrs:lexer-state-channel cnvrs:*lexer-state*) :hidden)))
         (lexer (cnvrs:compile-lexer (list (list :original (list 'and "a" (list 'cnvrs:action callback))))))
         (token (aref (cnvrs:lex lexer "a") 0)))
    (check (and (eq :changed (cnvrs:lexeme-kind token))
                (string= "replacement" (cnvrs:lexeme-text token))
                (eq :hidden (cnvrs:lexeme-channel token))) "custom action mutable token state"))
  (let ((lexer nil) (inside nil) (calls 0))
    (setf lexer (cnvrs:compile-lexer
                 (list (list :a (list 'and
                                      (list 'cnvrs:predicate
                                            (lambda (source position)
                                              (declare (ignore source position))
                                              (incf calls)
                                              (unless inside
                                                (setf inside t)
                                                (unwind-protect (cnvrs:lex lexer "a") (setf inside nil)))
                                              t)) "a")))))
    (check (= 1 (length (cnvrs:lex lexer "a"))) "predicate may reenter the same simulator")
    (check (= calls 2) "reentrant predicate evaluated in both invocations"))
  (dolist (expression '((* (cnvrs:? "a")) (+ (and)) (* (cnvrs:eof))))
    (check (handler-case
               (progn (cnvrs:compile-lexer (list (list :bad (list 'and "x" expression)))) nil)
             (cnvrs:grammar-error () t)) "reject non-progressing repetition ~S" expression))
  (let* ((lexer (cnvrs:compile-lexer
                 '((:word (+ (cnvrs:unicode-property "L"))) (:number (+ (cnvrs:range #\0 #\9)))
                   (:space " " :skip t)) :cache-backend '(:locked :hash-table)))
         (source "alpha βeta 123 gamma 456")
         (expected (map 'list #'token-shape (cnvrs:lex lexer source)))
         (expected-dfa (dfa-shape lexer)))
    (cnvrs:clear-cache lexer)
    (let ((threads (loop repeat 4 collect
                    (bordeaux-threads:make-thread
                     (lambda ()
                       (loop repeat 10 always
                         (equal expected (map 'list #'token-shape (cnvrs:lex lexer source)))))
                     :name "lexer parity worker"))))
      (dolist (thread threads) (check (bordeaux-threads:join-thread thread) "shared DFA token stream")))
    (check (equal expected-dfa (dfa-shape lexer)) "shared DFA interning retains sequential cache size")))

(defun run-tests ()
  (setf *checks* 0)
  (let ((lexer (import-lexer "LexerParity.g4" :callbacks
                             '(("{enabled}" . callback-guard) ("{after()}" . callback-after) ("{event(1);}" . event-1)
                               ("{event(2);}" . event-2) ("{event(3);}" . event-3)
                               ("{event(4);}" . event-4) ("{event(5);}" . event-5)))))
    (compare-oracle lexer "lexer-parity.sexp"))
  (let* ((definition cnvrs/tests/lexer-atn/native:*lexer*)
         (file (cnvrs:ensure-compiled definition))
         (runtime (cnvrs:compile-lexer
                   (loop for (name expression lexer-p skip channel mode push pop set)
                           in (cnvrs::parser-definition-rules definition)
                         collect (append (list name expression :skip skip :channel channel :mode mode)
                                 (when push (list :push-mode push))
                                 (when pop (list :pop-mode pop))
                                 (when set (list :set-mode set)))))))
    (dolist (lexer (list file runtime))
      (check (and (aref (cnvrs:compiled-lexer-skips lexer) 15)
                  (eq :COMMENTS (aref (cnvrs:compiled-lexer-channels lexer) 16))
                  (eq :STR (aref (cnvrs:compiled-lexer-push-modes lexer) 14)))
             "static command inspection survives runtime/file compilation"))
    (compare-oracle file "lexer-parity.sexp")
    (compare-oracle runtime "lexer-parity.sexp")
    (let ((copy (cnvrs:clone-compiled runtime)))
      (check (not (eq (cnvrs:lexer-simulator runtime) (cnvrs:lexer-simulator copy))) "clone owns its DFA")
      (compare-oracle copy "lexer-parity.sexp")
      (cnvrs:clear-cache copy)
      (check (every (lambda (x) (equal x '(0 0))) (dfa-shape copy)) "clear-cache resets all lexer DFAs")
      (compare-oracle copy "lexer-parity.sexp")))
  (compare-oracle (import-lexer "LexerCaseParity.g4") "lexer-case-parity.sexp")
  (compare-oracle (import-lexer "Java8Lexer.g4") "java8-lexer.sexp")
  (adaptation-checks)
  (format t "~D ANTLR Java lexer checks passed.~%" *checks*)
  t)

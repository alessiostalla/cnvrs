(defpackage #:cnvrs/tests/ll1 (:use #:cl) (:export #:run-tests))
(defpackage #:cnvrs/tests/ll1/parser (:use))
(defpackage #:cnvrs/tests/ll1/lexer (:use))
(in-package #:cnvrs/tests/ll1)
(defvar *checks* 0)
(defun check (value control &rest args)
  (incf *checks*) (unless value (error "Java LL(1) mismatch: ~?" control args)))
(defun fixture (name)
  (asdf:system-relative-pathname :cnvrs (concatenate 'string "test/fixtures/runtime/" name)))
(defun enabled (input position) (declare (ignore input position)) t)
(defun import-grammar (name &rest options)
  (apply #'cnvrs/antlr4:parse (uiop:read-file-string (fixture name))
         :parser-package :cnvrs/tests/ll1/parser :lexer-package :cnvrs/tests/ll1/lexer options))
(defun capture-predictions (thunk)
  (let ((original (symbol-function 'cnvrs/runtime:adaptive-predict)) (calls nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'cnvrs/runtime:adaptive-predict)
                 (lambda (&rest args) (push (third args) calls) (apply original args)))
           (values (funcall thunk) (nreverse calls)))
      (setf (symbol-function 'cnvrs/runtime:adaptive-predict) original))))
(defun comparable-name (symbol)
  (remove #\- (symbol-name symbol)))
(defun compare-oracle (grammar file &optional definition)
  (let* ((sim (cnvrs:parser-prediction-simulator grammar))
         (atn (cnvrs/runtime:simulator-atn sim))
         (types (second (cnvrs::ensure-parser-runtime grammar)))
         (other (cnvrs/runtime::atn-max-token-type atn))
         (keys (cnvrs::parser-token-keys grammar))
         (allowed (loop for key across keys collect (gethash key types))))
    (with-open-file (in (fixture file))
      (let* ((vocabulary (second (read in))) (java-types (make-hash-table))
             (lexical-rules (when definition
                              (cnvrs::parser-definition-rules
                               (let ((lexer (cnvrs:parser-lexer grammar)))
                                 (if (cnvrs:parser-definition-p lexer) lexer definition))))))
        (setf (gethash -1 java-types) -1)
        (dolist (entry vocabulary)
          (destructuring-bind (id name literal) entry
            (let ((key (or (and name (find name keys :test #'string-equal :key #'symbol-name))
                           (and literal
                                (first (find-if
                                        (lambda (rule)
                                          (let ((body (cnvrs/antlr4::lexer-literal-body (second rule))))
                                            (and (third rule) (stringp body) (string= literal body)))) lexical-rules))))))
              (setf (gethash id java-types) (if key (gethash key types other) other)))))
        (labels ((normalize (set) (sort (remove-duplicates (remove-if-not (lambda (n) (member n allowed)) set)) #'<))
                 (rule-name (name)
                   (or (loop for rule being the hash-keys of (cnvrs:parser-starts grammar)
                             when (string-equal name (comparable-name rule)) return rule)
                       (error "Missing rule ~A" name))))
          (loop for form = (read in nil nil) while form do
            (case (first form)
              (:decision
               (destructuring-bind (tag decision id direct expected) form
                 (declare (ignore tag))
                 (check (= id (aref (cnvrs/runtime:atn-decisions atn) decision)) "~A decision ~D state" file decision)
                 (let ((look (cnvrs/runtime:decision-lookahead atn id)))
                   (check (equal (map 'list (lambda (set) (normalize (remove-if-not (lambda (n) (member n allowed)) set))) look)
                                 (mapcar (lambda (set) (normalize (mapcar (lambda (n) (gethash n java-types)) set))) expected))
                          "~A decision ~D lookahead~%Java ~S~%Lisp ~S" file decision expected look)
                   (check (eq direct (not (null (cnvrs/runtime:lookahead-disjoint-p look)))) "~A decision ~D disjointness" file decision)
                   (check (eq direct (not (null (cnvrs:state-direct-lookahead (aref (cnvrs:parser-states grammar) id)))) )
                          "~A decision ~D direct dispatch" file decision))))
              (:case
               (destructuring-bind (tag name input expected calls) form
                 (declare (ignore tag))
                 (let ((tokens (mapcar (lambda (id)
                                        (let* ((entry (assoc id vocabulary))
                                               (name (second entry)))
                                          (find name keys :test #'string-equal :key #'symbol-name))) input)))
                   (dolist (generic '(nil t))
                     (let ((parser (cnvrs:clone-compiled grammar)))
                       (when generic (setf (cnvrs:parser-runner parser) nil (cnvrs:parser-node-runner parser) nil))
                       (dolist (builder '(:none :node))
                         (multiple-value-bind (actual predictions)
                             (capture-predictions
                              (lambda () (handler-case
                                             (progn (cnvrs:parse parser tokens :lexer nil :rule (rule-name name) :tree-builder builder) t)
                                           (cnvrs:parse-error () nil))))
                           (check (eq actual expected) "~A ~A ~S generic ~S builder ~S acceptance" file name input generic builder)
                           (when expected
                             (check (equal calls predictions) "~A ~A ~S generic ~S builder ~S adaptive calls Java ~S Lisp ~S"
                                    file name input generic builder calls predictions))))))))))))))))

(defun java8-execution-checks (grammar lexer)
  (let ((expected nil) (counts nil)
        (tokens (cnvrs:lex lexer (uiop:read-file-string
                                 (asdf:system-relative-pathname :cnvrs "bench/antlr4-grammar/Bench.java")))))
    (with-open-file (in (fixture "java8.sexp"))
      (loop for form = (read in nil nil) while form do
        (case (first form) (:predict (push (second form) expected)) (:dfa-counts (setf counts (second form))))))
    (cnvrs:clear-cache grammar)
    (multiple-value-bind (tree calls)
        (capture-predictions (lambda () (cnvrs:parse grammar tokens :lexer nil
                                                  :rule (find-symbol "COMPILATIONUNIT" :cnvrs/tests/ll1/parser))))
      (check (= 505 (cnvrs:node-end tree)) "full Java 8 tree endpoint")
      (check (= 1431 (length calls)) "Java 8 has exactly Java's 1431 adaptive calls")
      (check (equal (nreverse expected) calls) "Java 8 adaptive call order matches generated Java")
      (check (equal counts
                    (map 'list (lambda (d) (hash-table-count (cnvrs/runtime:dfa-states d)))
                         (cnvrs/runtime:simulator-decision-dfas (cnvrs:parser-prediction-simulator grammar))))
             "Java 8 per-decision DFA counts match generated Java"))))

(defun cache-checks ()
  (let* ((definition (cnvrs/antlr4:parse "lexer grammar Cache; A:'a'; B:'b';"
                                       :parser-package :cnvrs/tests/ll1/parser :lexer-package :keyword))
         (lexer (cnvrs:ensure-compiled definition))
         (parser (cnvrs:compile-grammar '((start (or (and :A :A) (and :A :B)))) :lexer definition)))
    (cnvrs:parse parser "ab")
    (let ((dfas (cnvrs/runtime:lexer-simulator-dfas (cnvrs:lexer-simulator lexer))))
      (check (some (lambda (d) (plusp (cnvrs/runtime:lexer-dfa-state-count d))) dfas) "attached definition lexer trained"))
    (check (plusp (cnvrs:cache-count (cnvrs:compiled-lexer-cache lexer))) "attached definition inspection cache trained")
    (check (eq parser (cnvrs:clear-cache parser)) "clear-cache return value")
    (check (every (lambda (d) (zerop (cnvrs/runtime:lexer-dfa-state-count d)))
                  (cnvrs/runtime:lexer-simulator-dfas (cnvrs:lexer-simulator lexer))) "attached definition lexer DFA cleared")
    (check (zerop (cnvrs:cache-count (cnvrs:compiled-lexer-cache lexer))) "attached definition inspection cache cleared")
    (check (zerop (cnvrs:cache-count (cnvrs:parser-decisions parser))) "parser DFA view cleared")
    (check (= 2 (cnvrs:node-end (cnvrs:parse parser "ab"))) "attached lexer/parser retrain after clear")
    (setf (cnvrs:parser-lexer parser) lexer)
    (cnvrs:clear-cache parser)
    (check (every (lambda (d) (zerop (cnvrs/runtime:lexer-dfa-state-count d)))
                  (cnvrs/runtime:lexer-simulator-dfas (cnvrs:lexer-simulator lexer))) "compiled lexer attachment still cleared"))
  (let* ((calls 0) (lexer (lambda (source) (incf calls) source))
         (parser (cnvrs:compile-grammar '((start :A)) :lexer lexer)))
    (cnvrs:clear-cache parser)
    (check (zerop calls) "clearing a parser never invokes a function lexer")))

(defun boundary-checks ()
  (dolist (source '(((start (or (and "word" :A) (and 17 :B))))
                    ((start (or (and nil :A) (and (cnvrs:token (:value)) :B))))))
    (let ((parser (cnvrs:compile-grammar source)))
      (dolist (input (if (stringp (second (second (second (first source)))))
                        '(("word" :A) (17 :B)) '((nil :A) ((:value) :B))))
        (check (= 2 (cnvrs:node-end (cnvrs:parse parser input))) "direct dispatch supports arbitrary Lisp token values"))))
  (let ((parser (cnvrs:compile-grammar '((start (or (and (cnvrs:any) :A) (cnvrs:eof)))))))
    (check (= 2 (cnvrs:node-end (cnvrs:parse parser '(:unknown :A)))) "wildcard direct dispatch handles extra token type")
    (check (zerop (cnvrs:node-end (cnvrs:parse parser nil))) "direct EOF dispatch"))
  (let* ((count 0)
         (action (lambda (input at) (declare (ignore input at)) (incf count)))
         (parser (cnvrs:compile-grammar (list (list 'start (list 'or (list 'and (list 'cnvrs:action action) :A) :B))))))
    (multiple-value-bind (result calls) (capture-predictions (lambda () (cnvrs:parse parser '(:A))))
      (check (and result (= count 1) (null calls)) "LL(1) analysis sees through actions without executing them")))
  (dolist (before '(nil t))
    (let* ((count 0) (predicate (lambda (input at) (declare (ignore input at)) (incf count) t))
           (body (if before (list 'and (list 'cnvrs:predicate predicate) :A)
                     (list 'and :A (list 'cnvrs:predicate predicate) :B)))
           (parser (cnvrs:compile-grammar (list (list 'start (list 'or body :C))))))
      (multiple-value-bind (result calls)
          (capture-predictions (lambda () (cnvrs:parse parser (if before '(:A) '(:A :B)))))
        (check (and result (plusp count) (if before calls (null calls))) "predicate before consumption blocks direct prediction, after consumption permits it")))))

(defun run-tests ()
  (setf *checks* 0)
  (let ((definition (import-grammar "LL1Parity.g4")))
    (compare-oracle (cnvrs:ensure-compiled definition) "ll1-parity.sexp" definition))
  (let* ((definition cnvrs/tests/ll1/native:*parser*)
         (file (cnvrs:ensure-compiled definition))
         (runtime (cnvrs:compile-grammar (loop for rule in (cnvrs::parser-definition-rules definition) collect (subseq rule 0 2)))))
    (compare-oracle file "ll1-parity.sexp")
    (compare-oracle runtime "ll1-parity.sexp"))
  (let ((definition (import-grammar "RuntimeParity.g4" :callbacks '(("{enabled}" . enabled)))))
    (compare-oracle (cnvrs:ensure-compiled definition) "runtime-ll1.sexp" definition))
  (let* ((lexer (import-grammar "Java8Lexer.g4"))
         (definition (import-grammar "Java8Parser.g4" :token-vocabulary (list (cons "Java8Lexer" lexer)))))
    (compare-oracle (cnvrs:ensure-compiled definition) "java8-ll1.sexp" definition)
    (java8-execution-checks (cnvrs:ensure-compiled definition) lexer))
  (cache-checks) (boundary-checks)
  (format t "~D Java LL(1) dispatch checks passed.~%" *checks*) t)

(asdf:defsystem #:cnvrs
  :description "Adaptive LL parsing of Lisp-form grammars with FASL compilation"
  :depends-on (#:fset #:bordeaux-threads)
  :serial t
  :in-order-to ((asdf:test-op (asdf:test-op "cnvrs/tests")))
  :components ((:file "src/runtime/package")
               (:file "src/runtime/prediction-context")
               (:file "src/runtime/atn-config")
               (:file "src/runtime/ll1-analyzer")
               (:file "src/runtime/parser-atn-simulator")
               (:file "src/runtime/lexer-atn-simulator")
               (:file "src/package")
               (:file "src/cache")
               (:file "src/graph")
               (:file "src/tokens")
               (:file "src/tree")
               (:file "src/cnvrs")
               (:file "src/native-atn")
               (:file "src/parser-runtime")
               (:file "src/semantic")
               (:static-file "src/unicode-data.sexp")
               (:file "src/unicode-data")
               (:file "src/lexer")
               (:file "src/lexer-atn")
               (:file "src/lexer-runtime")
               (:file "src/incremental")
               (:file "src/fasl")
               (:file "src/macros")
               (:file "src/antlr4-package")
               (:file "src/antlr4-parser")
               (:file "src/antlr4")
               (:file "src/antlr4-convert")))

(asdf:defsystem #:cnvrs/tests
  :depends-on (#:cnvrs)
  :serial t
  :components ((:file "test/runtime")
               (:file "test/file-expression")
               (:file "test/file-java")
               (:file "test/file-topology")
               (:file "test/atn-topology")
               (:file "test/file-ll1")
               (:file "test/file-wide-parser")
               (:file "test/ll1")
               (:file "test/file-lexer-atn")
               (:file "test/lexer-atn")
               (:file "test/cnvrs")
               (:file "test/incremental"))
  :perform (asdf:test-op (operation system)
             (declare (ignore operation system))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/TESTS"))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/TESTS/TOPOLOGY"))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/TESTS/LEXER-ATN"))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/TESTS/LL1"))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/TESTS/INCREMENTAL"))
             (funcall (find-symbol "RUN-TESTS" "CNVRS/RUNTIME/TESTS"))))

(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(defpackage #:java8/profile/parser (:use))
(defpackage #:java8/profile/lexer (:use))
(defparameter *grammar-paths* (uiop:command-line-arguments))
(unless (= (length *grammar-paths*) 2)
  (error "Usage: sbcl --script bench/java8/profile.lisp Java8Lexer.g4 Java8Parser.g4"))
(defparameter *java8-lexer*
  (cnvrs/antlr4:parse (uiop:read-file-string (first *grammar-paths*))
                    :parser-package '#:java8/profile/parser :lexer-package '#:java8/profile/lexer))
(defparameter *java8-parser*
  (cnvrs:ensure-compiled
   (cnvrs/antlr4:parse (uiop:read-file-string (second *grammar-paths*))
                     :parser-package '#:java8/profile/parser :lexer-package '#:java8/profile/lexer
                     :token-vocabulary (list (cons "Java8Lexer" *java8-lexer*)))))
(defparameter *source* (or (uiop:getenv "JAVA8_SOURCE") "class Hello { int f() { return 1; } }"))
(defparameter *tokens* (cnvrs:lex *java8-lexer* *source*))
(defparameter *entry* (find-symbol "COMPILATIONUNIT" '#:java8/profile/parser))
(when (uiop:getenv "PROFILE_SKIP_TWO_TOKEN")
  (setf (symbol-function 'cnvrs::two-token-lookahead)
        (lambda (&rest args) (declare (ignore args)) nil)))
;; Diagnostic only: preserve full stack identity while replacing nested keys
;; with canonical integer IDs. These tables live only for this profiling process.
(when (uiop:getenv "PROFILE_INTERN_STACK_KEYS")
  (let ((by-stack (make-hash-table :test 'eq))
        (by-pair (make-hash-table :test 'equal)))
    (labels ((stack-id (stack)
               (if (null stack) 0
                   (or (gethash stack by-stack)
                       (setf (gethash stack by-stack)
                             (let ((key (cons (car stack) (stack-id (cdr stack)))))
                               (or (gethash key by-pair)
                                   (setf (gethash key by-pair)
                                         (1+ (hash-table-count by-pair))))))))))
      (setf (symbol-function 'cnvrs::configuration-key)
            (lambda (configuration)
              (list (cnvrs::configuration-state configuration)
                    (stack-id (cnvrs::configuration-stack configuration))
                    (cnvrs::configuration-alternative configuration)))))))
(format t "~&INPUT ~S CHARACTERS ~D TOKENS ~D~%" *source* (length *source*) (length *tokens*))
(finish-output)

(require :sb-sprof)

(defparameter *visit-budget*
  (parse-integer (or (uiop:getenv "PROFILE_VISIT_BUDGET") "200000")))
(defvar *decision-state* nil)
(defvar *decision-position* nil)
(defvar *lookahead-token* nil)
(defvar *visits* 0)
(defvar *phase* nil)
(defvar *closures* nil)
(defvar *calls* (make-hash-table))
(defparameter *owners* (make-hash-table))

(defun run-count-profile ()
  (let ((old (symbol-function 'cnvrs::two-token-lookahead)))
    (setf (symbol-function 'cnvrs::two-token-lookahead)
          (lambda (grammar state-id stack)
            (let ((*phase* :two-token-lookahead))
              (funcall old grammar state-id stack)))))
  (maphash (lambda (name start)
             (dolist (id (cnvrs::compiled-rule-states *java8-parser* start))
               (setf (gethash id *owners*) name)))
           (cnvrs:parser-starts *java8-parser*))
  (let ((old (symbol-function 'cnvrs::compiled-choice-index)))
    (setf (symbol-function 'cnvrs::compiled-choice-index)
          (lambda (grammar id stack context input position)
            (let ((*decision-state* id) (*decision-position* position))
              (incf (gethash id *calls* 0))
              (funcall old grammar id stack context input position)))))
  (let ((old (symbol-function 'cnvrs::advance-dfa)))
    (setf (symbol-function 'cnvrs::advance-dfa)
          (lambda (grammar dfa token)
            (let ((*lookahead-token* (cnvrs::token-key token)))
              (funcall old grammar dfa token)))))
  (let ((old (symbol-function 'cnvrs::graph-closure)))
    (setf (symbol-function 'cnvrs::graph-closure)
          (lambda (seeds key visit &key (test 'equal))
            (let ((count 0) (depth 0) (hashes (make-hash-table)) (unique (make-hash-table :test 'equal))
                  (began (get-internal-real-time)))
              (unwind-protect
                   (funcall old seeds key
                            (lambda (item pending result)
                              (incf count) (incf *visits*)
                              (incf (gethash (sxhash (funcall key item)) hashes 0))
                              (when (cnvrs::configuration-p item)
                                (setf depth (max depth (length (cnvrs::configuration-stack item))))
                                (setf (gethash (cons (cnvrs::configuration-state item)
                                                     (cnvrs::configuration-alternative item)) unique) t))
                              (when (>= *visits* *visit-budget*) (throw 'budget :visit-budget))
                              (funcall visit item pending result))
                            :test test)
                (push (list :decision *decision-state* :position *decision-position*
                            :owner (gethash *decision-state* *owners*)
                            :lookahead *lookahead-token* :phase *phase* :visits count
                            :hashes (hash-table-count hashes)
                            :max-hash-bucket (loop for n being the hash-values of hashes maximize n)
                            :unique-state-alts (hash-table-count unique) :max-stack depth
                            :ms (* 1000.0 (/ (- (get-internal-real-time) began)
                                            internal-time-units-per-second)))
                      *closures*))))))
  (let ((began (get-internal-real-time)))
    (format t "~&RESULT ~S~%"
            (catch 'budget
              (cnvrs:parse *java8-parser* *tokens* :lexer nil :rule *entry* :tree-builder :none)
              :success))
    (format t "ELAPSED-MS ~F VISITS ~D CLOSURES ~D DECISIONS ~D~%"
            (* 1000.0 (/ (- (get-internal-real-time) began) internal-time-units-per-second))
            *visits* (length *closures*) (hash-table-count *calls*)))
  (dolist (row (subseq (sort *closures* #'> :key (lambda (r) (getf r :visits)))
                      0 (min 15 (length *closures*))))
    (format t "~S~%" row)))

(defun run-sample-profile ()
  (sb-sprof:with-profiling (:reset t :mode :cpu :threads (list sb-thread:*current-thread*)
                            :sample-interval 0.001 :max-samples 20000 :report :flat)
    (handler-case
        (sb-ext:with-timeout (parse-integer (or (uiop:getenv "PROFILE_SECONDS") "10"))
          (time (cnvrs:parse *java8-parser* *tokens* :lexer nil :rule *entry* :tree-builder :none))
          (format t "~&PARSE-SUCCESS~%"))
      (sb-ext:timeout () (format t "~&PARSE-TIMEOUT~%"))))
  (sb-sprof:report :type :graph :max 30)
  (format t "~&CACHE SLL ~D FULL ~D DIRECT ~D CONTEXTS ~D~%"
          (cnvrs:cache-count (cnvrs:parser-sll-decisions *java8-parser*))
          (cnvrs:cache-count (cnvrs:parser-decisions *java8-parser*))
          (cnvrs:cache-count (cnvrs:parser-direct-decisions *java8-parser*))
          (cnvrs:cache-count (cnvrs::parser-contexts *java8-parser*))))

(defun run-timing-profile ()
  (handler-case
      (sb-ext:with-timeout (parse-integer (or (uiop:getenv "PROFILE_SECONDS") "10"))
        (let* ((began (get-internal-real-time))
               (tree (cnvrs:parse *java8-parser* *tokens* :lexer nil :rule *entry*)))
          (format t "~&COLD-MS ~F END ~D~%"
                  (* 1000.0 (/ (- (get-internal-real-time) began)
                               internal-time-units-per-second))
                  (cnvrs:node-end tree)))
        (let ((began (get-internal-real-time)))
          (loop repeat 1000 do
            (cnvrs:parse *java8-parser* *tokens* :lexer nil :rule *entry*
                         :tree-builder :none))
          (format t "WARM-MS ~F~%"
                  (/ (- (get-internal-real-time) began)
                     (float internal-time-units-per-second)))))
    (sb-ext:timeout () (format t "~&PARSE-TIMEOUT~%"))))

(let ((mode (or (uiop:getenv "PROFILE_MODE") "sample")))
  (cond ((equal mode "count") (run-count-profile))
        ((equal mode "sample") (run-sample-profile))
        ((equal mode "timing") (run-timing-profile))
        (t (error "Unknown PROFILE_MODE ~S" mode))))

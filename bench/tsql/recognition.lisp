;;; Requires a fresh core made by prepare-core.lisp; do not reload ASDF sources.
(in-package #:tsql-reference/bench)
(defvar *sink*)
(let* ((parser *benchmark-parser*)
       (source (uiop:read-file-string "bench/tsql/examples/dml_select.sql"))
       (tokens (cnvrs:lex (cnvrs:ensure-compiled (cnvrs:parser-lexer parser)) source))
       (entry 'tsql-reference/bench/parser::tsql_file)
       (sim (cnvrs:parser-prediction-simulator parser)))
  (assert (= (length tokens) 2949))
  (assert (funcall (cnvrs:parser-runner parser) parser
                   (cnvrs::make-token-input tokens '(:default)) entry t))
  (flet ((run () (setf *sink* (cnvrs:parse parser tokens :lexer nil :rule entry :tree-builder :none))))
    (dotimes (i 10) (run))
    (sb-ext:gc :full t)
    (dotimes (batch 7)
      (let ((start (get-internal-real-time)) (cpu (get-internal-run-time))
            (bytes (sb-ext:get-bytes-consed)))
        (dotimes (i 5) (run))
        (format t "WARM ~D MS ~,6F CPU ~,6F BYTES ~,1F~%" (1+ batch)
                (/ (* 1000d0 (- (get-internal-real-time) start)) (* 5 internal-time-units-per-second))
                (/ (* 1000d0 (- (get-internal-run-time) cpu)) (* 5 internal-time-units-per-second))
                (/ (- (sb-ext:get-bytes-consed) bytes) 5d0)))
      (finish-output)))
  (format t "CACHE STATES ~D CONTEXTS ~D~%"
          (reduce #'+ (cnvrs/runtime:simulator-decision-dfas sim)
                  :key (lambda (d) (hash-table-count (cnvrs/runtime:dfa-states d))))
          (loop for bucket being the hash-values of (cnvrs/runtime:simulator-context-cache sim) sum (length bucket))))

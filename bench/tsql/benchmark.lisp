(load "bench/tsql/prepare.lisp")
(in-package #:tsql-reference/bench)
(defvar *sink*)
(defun ms-since (start)
  (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
(defun token-signature (tokens)
  (let ((hash #xcbf29ce484222325))
    (flet ((mix (n) (setf hash (ldb (byte 64 0) (* (logxor hash n) #x100000001b3)))))
      (loop for token across tokens do
        (map nil (lambda (c) (mix (char-code c))) (cnvrs:lexeme-text token))
        (dolist (n (list #xffffffff (cnvrs:lexeme-start token) (cnvrs:lexeme-end token)
                         (cnvrs:lexeme-line token) (cnvrs:lexeme-column token)
                         (if (eq (cnvrs:lexeme-channel token) :default) 0 1))) (mix n))))
    (format nil "~16,'0X" hash)))
(defun kind-signature (tokens)
  (let ((hash #xcbf29ce484222325))
    (loop for token across tokens do
      (loop for c across (symbol-name (cnvrs:lexeme-kind token)) do
        (setf hash (ldb (byte 64 0) (* (logxor hash (char-code c)) #x100000001b3))))
      (setf hash (ldb (byte 64 0) (* (logxor hash #xffffffff) #x100000001b3))))
    (format nil "~16,'0X" hash)))
(let* ((args (uiop:command-line-arguments))
       (source (uiop:read-file-string (second args) :external-format :utf-8))
       (parser *benchmark-parser*)
       (lexer (cnvrs:ensure-compiled (cnvrs:parser-lexer parser)))
       (tokens (cnvrs:lex lexer source))
       (entry (find-symbol "TSQL_FILE" :tsql-reference/bench/parser))
       (expected (length tokens))
       (default-count (count :default tokens :key #'cnvrs:lexeme-channel)))
  ;; Initialize the typed parser ATN before timing; no grammar conversion/lowering is timed.
  (cnvrs:parser-prediction-simulator parser)
  (let ((latn (cnvrs/runtime:lexer-simulator-atn (cnvrs:lexer-simulator lexer)))
        (patn (cnvrs/runtime:simulator-atn (cnvrs:parser-prediction-simulator parser))))
    (format t "TOPOLOGY LEXER-RULES ~D LEXER-STATES ~D PARSER-RULES ~D PARSER-STATES ~D DECISIONS ~D~%"
            (length (cnvrs/runtime:atn-rule-starts latn)) (length (cnvrs/runtime:atn-states latn))
            (length (cnvrs/runtime:atn-rule-stops patn)) (length (cnvrs/runtime:atn-states patn))
            (length (cnvrs/runtime:atn-decisions patn))))
  (format t "DEFAULT-TOKENS ~D~%" default-count)
  (format t "RUNTIME SBCL ~A GRAMMAR ~A CHARACTERS ~D TOKENS ~D SIGNATURE ~A~%"
          (lisp-implementation-version) (first args) (length source) (length tokens) (token-signature tokens))
  (format t "KIND-SIGNATURE ~A~%" (kind-signature tokens))
  (labels ((clear () (cnvrs:clear-cache parser) (cnvrs:clear-cache lexer))
           (run (phase)
             (let ((input tokens))
               (when (member phase '(:lexer :pipeline-tree))
                 (setf input (cnvrs:lex lexer source))
                 (assert (= expected (length input))))
               (setf *sink*
                     (if (eq phase :lexer) input
                         (cnvrs:parse parser input :lexer nil :rule entry
                                      :tree-builder (if (eq phase :parse-none) :none :node))))
               (unless (eq phase :parse-none) (assert *sink*))
               (when (member phase '(:parse-tree :pipeline-tree))
                 (assert (= default-count (cnvrs:node-end *sink*))))))
           (caches (phase)
             (let* ((ldfas (cnvrs/runtime:lexer-simulator-dfas (cnvrs:lexer-simulator lexer)))
                    (pdfas (cnvrs/runtime:simulator-decision-dfas (cnvrs:parser-prediction-simulator parser))))
               (format t "CACHE ~A LEXER-STATES ~D LEXER-EDGES ~D PARSER-STATES ~D CONTEXTS ~D~%" phase
                       (reduce #'+ ldfas :key #'cnvrs/runtime:lexer-dfa-state-count)
                       (loop for d across ldfas sum
                         (loop for bucket being the hash-values of (cnvrs/runtime:lexer-dfa-states d) sum
                           (loop for s in bucket sum (count-if #'identity (cnvrs/runtime:lexer-dfa-state-edges s)))))
                       (reduce #'+ pdfas :key (lambda (d) (hash-table-count (cnvrs/runtime:dfa-states d))))
                       (loop for bucket being the hash-values of (cnvrs/runtime:simulator-context-cache (cnvrs:parser-prediction-simulator parser)) sum (length bucket))))))
    (dolist (phase '(:lexer :parse-none :parse-tree :pipeline-tree))
      (let ((iterations (if (eq phase :lexer) 100 2)))
        (clear)
      (let ((bytes (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
        (run phase)
        (format t "FIRST ~A MS ~,6F BYTES ~D~%" phase (ms-since start) (- (sb-ext:get-bytes-consed) bytes)))
      ;; Lisp is already native compiled. Train/exercise each path before cold-DFA trials.
      (dotimes (i 10) (run phase))
      (dotimes (trial 3)
        (clear) (sb-ext:gc :full t)
        (let ((bytes (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
          (run phase)
          (format t "COLD ~A TRIAL ~D MS ~,6F BYTES ~D~%" phase (1+ trial) (ms-since start) (- (sb-ext:get-bytes-consed) bytes)))
        (finish-output))
      (run phase)
      (dotimes (batch 7)
        (let ((bytes (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
          (dotimes (i iterations) (run phase))
          (format t "WARM ~A BATCH ~D MS ~,6F BYTES ~,1F~%" phase (1+ batch) (/ (ms-since start) iterations)
                  (/ (- (sb-ext:get-bytes-consed) bytes) (float iterations 1d0))))
        (finish-output))
      (caches phase) (finish-output)))))

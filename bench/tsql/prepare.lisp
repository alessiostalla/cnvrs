(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(defpackage #:tsql-reference/bench (:use #:cl))
(defpackage #:tsql-reference/bench/parser (:use))
(defpackage #:tsql-reference/bench/lexer (:use))
(in-package #:tsql-reference/bench)
(defvar *benchmark-parser*
  (let* ((lexer-definition (cnvrs/antlr4:parse (uiop:read-file-string "bench/tsql/TSqlLexer.g4")
                           :parser-package :tsql-reference/bench/parser :lexer-package :tsql-reference/bench/lexer))
       (definition (cnvrs/antlr4:parse (uiop:read-file-string "bench/tsql/TSqlParser.g4")
                     :parser-package :tsql-reference/bench/parser :lexer-package :tsql-reference/bench/lexer
                     :token-vocabulary (list (cons "TSqlLexer" lexer-definition))))
       (parser (cnvrs:ensure-compiled definition)))
    (cnvrs:parser-prediction-simulator parser)
    parser))
(format t "T-SQL preparation succeeded.~%")

;;; Diagnostic fixture replay: hash distribution, never a parser timing harness.
(in-package #:tsql-reference/bench)
(defvar *fixtures* nil)
(defvar *steps* 0)
(let* ((parser *benchmark-parser*)
       (tokens (cnvrs:lex (cnvrs:ensure-compiled (cnvrs:parser-lexer parser))
                          (uiop:read-file-string "bench/tsql/examples/dml_select.sql"))))
  (dotimes (i 10) (cnvrs:parse parser tokens :lexer nil :rule 'tsql-reference/bench/parser::tsql_file :tree-builder :none))
  (let* ((name 'cnvrs/runtime::config-set-single-viable-alt) (old (symbol-function name)))
    (unwind-protect
        (progn (setf (symbol-function name)
                     (lambda (set workspace)
                       (let ((answer (funcall old set workspace)))
                         (push (list (cnvrs/runtime:make-atn-config-set
                                      :items (map 'vector #'cnvrs/runtime::copy-atn-config (cnvrs/runtime:config-set-items set))) answer) *fixtures*)
                         answer)))
               (cnvrs:parse parser tokens :lexer nil :rule 'tsql-reference/bench/parser::tsql_file :tree-builder :none))
      (setf (symbol-function name) old))))
(format t "FIXTURES ~D CONFIGS ~D~%" (length *fixtures*) (loop for (s) in *fixtures* sum (length (cnvrs/runtime:config-set-items s))))
(let* ((*package* (find-package :cnvrs/runtime))
       (name 'cnvrs/runtime::config-set-single-viable-alt)
       (form (with-open-file (s "src/runtime/atn-config.lisp")
               (loop for f = (read s nil) while f when (and (consp f) (eq (first f) 'defun) (eq (second f) name)) return f))))
  (labels ((replace-hash (x fn)
             (cond ((atom x) x)
                   ((eq (car x) 'cnvrs/runtime::murmur-finish) (funcall fn x))
                   (t (mapcar (lambda (v) (replace-hash v fn)) x))))
           (measure (label)
             (let ((workspace (cnvrs/runtime::make-conflict-workspace)))
               (sb-ext:gc :full t)
               (time (dotimes (i 10)
                       (dolist (f *fixtures*)
                         (assert (eql (second f) (funcall (symbol-function name) (first f) workspace))))))
               (format t "VARIANT ~A~%" label))))
    (eval (replace-hash form (lambda (x) (second x))))
    (measure "RAW-UPDATE")
    (eval (replace-hash form (lambda (x) `(sxhash ,(second x)))))
    (measure "SXHASH")
    (eval (replace-hash form (lambda (x) x)))
    (measure "FINISH")))

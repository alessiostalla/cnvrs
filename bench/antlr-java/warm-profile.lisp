;;; Warm Java 8 CPU/allocation profiles and Java-matched operation counters.
(require :asdf)
(require :sb-sprof)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(defpackage #:java8/profile/parser (:use))
(defpackage #:java8/profile/lexer (:use))
(defparameter *grammar-paths* (uiop:command-line-arguments))
(unless (= (length *grammar-paths*) 2)
  (error "Usage: sbcl --script bench/antlr-java/warm-profile.lisp Java8Lexer.g4 Java8Parser.g4"))
(defparameter *java8-lexer*
  (cnvrs/antlr4:parse (uiop:read-file-string (first *grammar-paths*))
                    :parser-package '#:java8/profile/parser :lexer-package '#:java8/profile/lexer))
(defparameter *java8-parser*
  (cnvrs:ensure-compiled
   (cnvrs/antlr4:parse (uiop:read-file-string (second *grammar-paths*))
                     :parser-package '#:java8/profile/parser :lexer-package '#:java8/profile/lexer
                     :token-vocabulary (list (cons "Java8Lexer" *java8-lexer*)))))
(defparameter *source*
  (let ((file (uiop:getenv "JAVA8_SOURCE_FILE")))
    (cond (file (uiop:read-file-string file))
          ((uiop:getenv "JAVA8_SOURCE"))
          (t (uiop:read-file-string "bench/antlr4-grammar/Bench.java")))))
(defparameter *tokens* (cnvrs:lex *java8-lexer* *source*))
(defparameter *entry* (find-symbol "COMPILATIONUNIT" '#:java8/profile/parser))
(defparameter *seconds* (parse-integer (or (uiop:getenv "PROFILE_SECONDS") "20")))
(defparameter *mode* (or (uiop:getenv "PROFILE_MODE") "cpu"))
(defun simulator (grammar) (cnvrs:parser-prediction-simulator grammar))
(defun cache-summary (grammar)
  (let ((dfas (cnvrs/antlr-runtime:simulator-decision-dfas (simulator grammar))))
    (format t "~&DFA ROOTS ~D STATES ~D~%"
            (count-if (lambda (d) (plusp (hash-table-count (cnvrs/antlr-runtime:dfa-states d)))) dfas)
            (reduce #'+ dfas :key (lambda (d) (hash-table-count (cnvrs/antlr-runtime:dfa-states d)))))))
(defun parse-one (grammar)
  (sb-ext:with-timeout *seconds*
    (cnvrs:parse grammar *tokens* :lexer nil :rule *entry*)))

(defvar *sink*)
(defvar *operation-counts*)
(defun run ()
  (setf *sink* (parse-one *java8-parser*))
  (assert (= (length *tokens*) (cnvrs:node-end *sink*))))
(dotimes (i 5) (run))
(sb-ext:gc :full t)
(format t "WARM PROFILE ~A SBCL ~A TOKENS ~D~%" *mode* (lisp-implementation-version) (length *tokens*))
(cond
 ((equal *mode* "operations")
  (let ((counts (make-hash-table)) (saved nil) (sequence nil))
    (labels ((bump (key &optional (n 1)) (incf (gethash key counts 0) n))
             (wrap (name key &optional special)
               (let ((original (symbol-function name)))
                 (push (cons name original) saved)
                 (setf (symbol-function name)
                       (lambda (&rest args)
                         (bump key)
                         (case special
                           (:adaptive (push (list (third args) (getf (cdddr args) :position)) sequence))
                           (:reach (bump :reach-input (length (cnvrs/antlr-runtime:config-set-items (second args))))
                                   (when (fourth args) (bump :full-reach)))
                           (:start (when (fourth args) (bump :full-start))))
                         (let ((answer (apply original args)))
                           (when (and (eq special :reach) answer)
                             (bump :reach-output (length (cnvrs/antlr-runtime:config-set-items answer))))
                           answer))))))
      (unwind-protect
          (progn
            ;; SBCL can compile self-recursion as local calls, bypassing an
            ;; fdefinition wrapper. Insert this counter into the diagnostic copy.
            (let* ((name 'cnvrs/antlr-runtime::closure-checking-stop-state)
                   (original (symbol-function name))
                   (*package* (find-package :cnvrs/antlr-runtime))
                   (form (with-open-file (in "src/antlr-runtime/parser-atn-simulator.lisp")
                           (loop for f = (read in nil) while f
                                 when (and (consp f) (eq (car f) 'defun) (eq (second f) name)) return f)))
                   (body (cdddr form)))
              (push (cons name original) saved)
              (compile name `(lambda ,(third form) ,(first body)
                               (incf (gethash :closure-check cl-user::*operation-counts* 0))
                               (block ,name ,@(rest body)))))
            (dolist (spec '((cnvrs/antlr-runtime:adaptive-predict :adaptive :adaptive)
                            (cnvrs/antlr-runtime:compute-start-state :start :start)
                            (cnvrs/antlr-runtime:compute-reach-set :reach :reach)
                            (cnvrs/antlr-runtime::closure-work :closure-work)
                            (cnvrs/antlr-runtime::get-epsilon-target :epsilon)
                            (cnvrs/antlr-runtime::exec-atn-with-full-context :fallback)
                            (cnvrs/antlr-runtime:config-set-add :config-add)
                            (cnvrs/antlr-runtime:merge-contexts :merge)))
              (apply #'wrap spec))
            (let ((*operation-counts* counts)) (run)))
        (dolist (entry saved) (setf (symbol-function (car entry)) (cdr entry))))
      (dolist (key (sort (loop for k being the hash-keys of counts collect k) #'string<))
        (format t "COUNT ~A ~D~%" key (gethash key counts)))
      (dolist (call (nreverse sequence)) (format t "PREDICT ~D ~D~%" (first call) (second call))))))
 ((equal *mode* "cpu")
  (sb-sprof:with-profiling (:reset t :mode :cpu :sample-interval 0.001
                                  :max-samples 20000 :report :graph)
    (time (dotimes (i 30) (run)))))
 ((equal *mode* "alloc")
  (sb-sprof:with-profiling (:reset t :mode :alloc
                                  :max-samples 200000 :report :graph)
    (time (dotimes (i 30) (run)))))
 (t (error "Unknown mode ~A" *mode*)))
(cache-summary *java8-parser*)
(format t "CONTEXTS ~D~%" (loop for bucket being the hash-values of
                           (cnvrs/antlr-runtime:simulator-context-cache (simulator *java8-parser*))
                           sum (length bucket)))

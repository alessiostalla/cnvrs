;;; One trained parse: storage-operation counts, separate from timing.
(load "bench/antlr-java/warm-profile.lisp")
(defvar *storage-counters* (make-hash-table))
(defvar *merging-kind* nil)
(let ((saved nil))
  (unwind-protect
       (progn
         (dolist (spec '((cnvrs/antlr-runtime::derive-config :derive)
                         (cnvrs/antlr-runtime:config-set-add :config-add)
                         (cnvrs/antlr-runtime::merge-arrays :array-merges)
                         (cnvrs/antlr-runtime::merge-singletons :singleton-merges)
                         (cnvrs/antlr-runtime::merge-cache-get :cache-get)
                         (cnvrs/antlr-runtime::merge-cache-put :cache-put)
                         (cnvrs/antlr-runtime::context-node :array-node)
                         (cnvrs/antlr-runtime:singleton-context :singleton-node)))
           (let* ((name (first spec)) (kind (second spec)) (original (symbol-function name)))
             (push (cons name original) saved)
             (setf (symbol-function name)
                   (lambda (&rest args)
                     (incf (gethash kind *storage-counters* 0))
                     (when (and (eq kind :array-node) (eq *merging-kind* :array-merges))
                       (incf (gethash :array-merge-output-entries *storage-counters* 0) (length (first args))))
                     (when (and (eq kind :cache-put) (first args))
                       (incf (gethash :cache-writes *storage-counters* 0)))
                     (let* ((old-size (when (eq kind :config-add)
                                        (length (cnvrs/antlr-runtime:config-set-items (first args)))))
                            (*merging-kind* (if (member kind '(:array-merges :singleton-merges)) kind *merging-kind*))
                            (answer (apply original args)))
                       (when (and (eq kind :config-add)
                                  (> (length (cnvrs/antlr-runtime:config-set-items (first args))) old-size))
                         (incf (gethash :new-config-entries *storage-counters* 0)))
                       (when (and (eq kind :singleton-node)
                                  (not (eq answer (cnvrs/antlr-runtime:empty-prediction-context))))
                         (incf (gethash :singleton-allocations *storage-counters* 0)))
                       (when (and (eq kind :cache-get) answer) (incf (gethash :cache-hits *storage-counters* 0)))
                       answer)))))
         (run))
    (dolist (entry saved) (setf (symbol-function (car entry)) (cdr entry))))
  (maphash (lambda (key value) (format t "STORAGE ~A ~D~%" key value)) *storage-counters*))

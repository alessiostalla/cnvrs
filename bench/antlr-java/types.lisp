;;; Before/after harness shared by an archived baseline and the working tree.
(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(defpackage #:types/bench (:use #:cl))
(defpackage #:types/bench/parser (:use))
(defpackage #:types/bench/lexer (:use))
(in-package #:types/bench)
(declaim (optimize (speed 3) (safety 1)))
(defvar *sink*)
(defun import-grammar (file &rest options)
  (apply #'cnvrs/antlr4:parse (uiop:read-file-string file)
         :parser-package :types/bench/parser :lexer-package :types/bench/lexer options))
(defun ms-since (start)
  (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
(defun signature (tokens)
  (let ((hash #xcbf29ce484222325))
    (flet ((mix (n) (setf hash (ldb (byte 64 0) (* (logxor hash n) #x100000001b3)))))
      (loop for token across tokens do
        (map nil (lambda (c) (mix (char-code c))) (cnvrs:lexeme-text token))
        (dolist (n (list #xffffffff (cnvrs:lexeme-start token) (cnvrs:lexeme-end token)
                         (cnvrs:lexeme-line token) (cnvrs:lexeme-column token)
                         (if (eq (cnvrs:lexeme-channel token) :default) 0 1))) (mix n))))
    (format nil "~16,'0X" hash)))
(format t "SBCL ~A LABEL ~A~%" (lisp-implementation-version) (first (uiop:command-line-arguments)))
(dolist (grammar '("iri" "java8"))
  (let* ((iri (string= grammar "iri"))
         (lexer-definition (unless iri (import-grammar "test/fixtures/antlr-runtime/Java8Lexer.g4")))
         (parser (cnvrs:ensure-compiled
                  (if iri (import-grammar "test/fixtures/IRI.g4")
                      (import-grammar "test/fixtures/antlr-runtime/Java8Parser.g4"
                                      :token-vocabulary (list (cons "Java8Lexer" lexer-definition))))))
         (lexer (cnvrs:ensure-compiled (cnvrs:parser-lexer parser)))
         (source (uiop:read-file-string (if iri "bench/antlr-java/iri.txt" "bench/antlr4-grammar/Bench.java")))
         (tokens (cnvrs:lex lexer source))
         (rule (find-symbol (if iri "PARSE" "COMPILATIONUNIT") :types/bench/parser))
         (expected (if iri 216 505)))
    (assert (= expected (length tokens)))
    (cnvrs:parser-prediction-simulator parser)
    (format t "GRAMMAR ~A CHARACTERS ~D TOKENS ~D SIGNATURE ~A~%" grammar (length source) expected (signature tokens))
    (labels ((clear () (cnvrs:clear-cache parser) (cnvrs:clear-cache lexer))
             (run (phase)
               (setf *sink* (if (eq phase :lexer) (cnvrs:lex lexer source)
                               (cnvrs:parse parser tokens :lexer nil :rule rule)))
               (assert (= expected (if (eq phase :lexer) (length *sink*) (cnvrs:node-end *sink*))))))
      (dolist (phase '(:lexer :parse-tree))
        (clear)
        (dotimes (i (if (and (not iri) (eq phase :parse-tree)) 5 20)) (run phase))
        (dotimes (trial 3)
          (clear) (sb-ext:gc :full t)
          (let ((start (get-internal-real-time)) (bytes (sb-ext:get-bytes-consed)))
            (run phase)
            (format t "COLD ~A ~A TRIAL ~D MS ~,6F BYTES ~D~%" grammar phase (1+ trial) (ms-since start) (- (sb-ext:get-bytes-consed) bytes)))
          (finish-output))
        (run phase)
        (let ((iterations (cond ((eq phase :lexer) 1000) (iri 100) (t 2))))
          (dotimes (batch 7)
            (let ((start (get-internal-real-time)) (bytes (sb-ext:get-bytes-consed)))
              (dotimes (i iterations) (run phase))
              (format t "WARM ~A ~A BATCH ~D MS ~,6F BYTES ~,1F~%" grammar phase (1+ batch)
                      (/ (ms-since start) iterations) (/ (- (sb-ext:get-bytes-consed) bytes) (float iterations 1d0))))
            (finish-output)))
        (format t "CACHE ~A ~A PARSER-STATES ~D LEXER-STATES ~D~%" grammar phase
                (reduce #'+ (cnvrs/antlr-runtime:simulator-decision-dfas (cnvrs:parser-prediction-simulator parser))
                        :key (lambda (d) (hash-table-count (cnvrs/antlr-runtime:dfa-states d))))
                (reduce #'+ (cnvrs/antlr-runtime:lexer-simulator-dfas (cnvrs:lexer-simulator lexer))
                        :key #'cnvrs/antlr-runtime:lexer-dfa-state-count))
        (finish-output)))))

;;; Source tree selected by CWD; no timing instrumentation.
(require :asdf)
(let ((*package* *package*))
  (with-open-file (s "bench/c-reference/benchmark.lisp")
    (loop for form = (read s nil) while form
          until (and (consp form) (eq (first form) 'let*)) do (eval form))))
(in-package #:c-reference/bench)
(defun tree-signature (tree)
  (let ((hash #xcbf29ce484222325))
    (labels ((mix (n) (setf hash (ldb (byte 64 0) (* (logxor hash n) #x100000001b3))))
             (visit (x)
               (typecase x
                 (null (mix 0))
                 (cnvrs::node (mix 1) (visit (cnvrs:node-rule x)) (visit (cnvrs:node-start x))
                             (visit (cnvrs:node-end x)) (visit (cnvrs:node-label x))
                             (visit (cnvrs:node-children x)))
                 (cnvrs::lexeme (mix 2) (visit (cnvrs:lexeme-kind x)) (visit (cnvrs:lexeme-text x))
                               (visit (cnvrs:lexeme-start x)) (visit (cnvrs:lexeme-end x))
                               (visit (cnvrs:lexeme-line x)) (visit (cnvrs:lexeme-column x))
                               (visit (cnvrs:lexeme-channel x)))
                 (cons (mix 3) (visit (car x)) (visit (cdr x)))
                 (symbol (mix 4) (visit (package-name (symbol-package x))) (visit (symbol-name x)))
                 (string (mix 5) (mix (length x)) (map nil (lambda (c) (mix (char-code c))) x))
                 (integer (mix 6) (mix x))
                 (t (error "Unexpected tree component ~S" (type-of x))))))
      (visit tree))
    (format nil "~16,'0X" hash)))

(let ((parser *benchmark-parser*) (generic (cnvrs:clone-compiled *benchmark-parser*)))
  (setf (cnvrs:parser-runner generic) nil (cnvrs:parser-node-runner generic) nil)
  (dolist (file '("bench/c-reference/examples/Wmisleading-indentation.pp.c" "bench/c-reference/pointers.c"))
    (let* ((tokens (cnvrs:lex (cnvrs:ensure-compiled (cnvrs:parser-lexer parser)) (uiop:read-file-string file)))
           (entry 'c-reference/bench/parser::compilationunit)
           (input (cnvrs::make-token-input tokens '(:default)))
           (tree (funcall (cnvrs:parser-node-runner parser) parser input entry t)))
      (assert tree)
      (assert (funcall (cnvrs:parser-runner parser) parser input entry t))
      (assert (equalp tree (cnvrs:parse generic tokens :lexer nil :rule entry)))
      (format t "VALIDATED ~A TOKENS ~D DEFAULT ~D TREE ~A~%" file (length tokens)
              (cnvrs:node-end tree) (tree-signature tree)))))

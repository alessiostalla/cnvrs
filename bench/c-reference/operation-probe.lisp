;;; C11 operation counters are separate from CPU/allocation sampling.
(require :asdf)
(require :sb-sprof)
(let ((*package* *package*))
  (with-open-file (s "bench/c-reference/warm-profile.lisp")
    (loop for form = (read s nil) while form
          until (and (consp form) (eq (first form) 'sb-sprof:with-profiling)) do (eval form))))
(in-package #:c-reference/bench)
(defvar *counts*)
(defvar *closure-decisions*)
(defun decision-rule (decision)
  (let* ((atn (cnvrs/runtime:simulator-atn (cnvrs:parser-prediction-simulator *benchmark-parser*)))
         (id (aref (cnvrs/runtime:atn-decisions atn) decision))
         (index (cnvrs/runtime:atn-state-rule (aref (cnvrs/runtime:atn-states atn) id))))
    (loop for name being the hash-keys of (cnvrs:parser-stops *benchmark-parser*) using (hash-value stop)
          when (= index (cnvrs/runtime:atn-state-rule (aref (cnvrs/runtime:atn-states atn) stop))) return name)))
(defun counters ()
  (let ((counts (make-hash-table :test 'equal)) (saved nil)
        (decisions (make-hash-table)) (fallbacks (make-hash-table))
        (closures (make-hash-table)) (sequence nil) (sets (make-hash-table :test 'eq)))
    (labels ((bump (key &optional (n 1)) (incf (gethash key counts 0) n))
             (wrap (name key &optional special)
               (let ((old (symbol-function name)))
                 (push (cons name old) saved)
                 (setf (symbol-function name)
                       (lambda (&rest args)
                         (bump key)
                         (case special
                           (:config-add
                            (let* ((set (first args)) (config (second args))
                                   (lookup (cnvrs/runtime::config-set-lookup set))
                                   (existing
                                     (if (hash-table-p lookup)
                                         (cnvrs/runtime::find-config-in-bucket
                                          config (gethash (cnvrs/runtime::config-lookup-hash config) lookup))
                                         (funcall (find-symbol "FIND-CONFIG-IN-SET" :cnvrs/runtime) set config))))
                              (setf (gethash set sets) t)
                              (bump (if existing "CONFIG-HIT" "CONFIG-INSERT"))))
                           (:conflict (when (cnvrs/runtime:unique-alt (first args))
                                        (bump "CONFLICT-UNIQUE-ALT")))
                           (:parents (bump (format nil "PARENTS-SIZE-~D" (length (first args)))))
                           (:context (when (eq (first args) (cnvrs/runtime:simulator-context-cache
                                                            (cnvrs:parser-prediction-simulator *benchmark-parser*)))
                                       (bump "SHARED-CONTEXT-CACHE-GET")))
                           (:adaptive (incf (gethash (third args) decisions 0))
                                      (push (list (third args) (getf (cdddr args) :position)) sequence))
                           (:fallback (incf (gethash (cnvrs/runtime::dfa-decision (first args)) fallbacks 0)))
                           (:reach (bump "REACH-INPUT" (length (cnvrs/runtime:config-set-items (second args))))
                                   (when (fourth args) (bump "FULL-REACH")))
                           (:start (when (fourth args) (bump "FULL-START"))))
                         (let ((bytes (when (eq special :conflict) (sb-ext:get-bytes-consed))))
                         (multiple-value-bind (answer source) (apply old args)
                           (when bytes (bump "CONFLICT-BYTES" (- (sb-ext:get-bytes-consed) bytes)))
                           (when (and (eq special :merge-get) answer) (bump "MERGE-CACHE-HIT"))
                           (when (and (eq special :busy) answer) (bump "BUSY-INSERT"))
                           (when (and (eq special :reach) answer)
                             (bump "REACH-OUTPUT" (length (cnvrs/runtime:config-set-items answer))))
                           (values answer source)))))))
             (source-form (name)
               (let ((*package* (find-package :cnvrs/runtime)))
                 (with-open-file (s "src/runtime/parser-atn-simulator.lisp")
                   (loop for f = (read s nil) while f
                     when (and (consp f) (eq (first f) 'defun) (eq (second f) name)) return f)))))
      (unwind-protect
           (progn
             (let* ((name 'cnvrs/runtime::closure-checking-stop-state)
                    (form (source-form name)) (body (cdddr form)))
               (push (cons name (symbol-function name)) saved)
               (compile name `(lambda ,(third form) ,(first body)
                                (incf (gethash "CLOSURE-CHECK" *counts* 0))
                                (incf (gethash (cnvrs/runtime::dfa-decision cnvrs/runtime::*current-dfa*) *closure-decisions* 0))
                                (block ,name ,@(rest body)))))
             (let* ((name 'cnvrs/runtime::closure-work) (form (source-form name)))
               (push (cons name (symbol-function name)) saved)
               (compile name `(lambda ,(third form)
                                (declare (notinline cnvrs/runtime::get-epsilon-target))
                                ,@(cdddr form))))
             (dolist (spec '((cnvrs/runtime:adaptive-predict "ADAPTIVE" :adaptive)
                             (cnvrs::prediction-token-input "TOKEN-INPUT-GET")
                             (cnvrs/runtime::config-set-single-viable-alt "COMPACT-GROUPS")
                             (cnvrs/runtime:compute-start-state "START" :start)
                             (cnvrs/runtime:compute-reach-set "REACH" :reach)
                             (cnvrs/runtime::closure-work "CLOSURE-WORK")
                             (cnvrs/runtime::get-epsilon-target "EPSILON")
                             (cnvrs/runtime::exec-atn-with-full-context "FALLBACK" :fallback)
                             (cnvrs/runtime:config-set-add "CONFIG-ADD" :config-add)
                             (cnvrs/runtime:merge-contexts "MERGE")
                             (cnvrs/runtime:conflicting-alt-subsets "CONFLICT-GROUPS" :conflict)
                             (cnvrs/runtime::busy-add "BUSY-ADD" :busy)
                             (cnvrs/runtime::combine-common-parents "COMBINE-PARENTS" :parents)
                             (cnvrs/runtime::merge-cache-get "MERGE-CACHE-GET" :merge-get)
                             (cnvrs/runtime::context-cache-get "CONTEXT-CACHE-GET" :context)))
               (apply #'wrap spec))
             (let ((*counts* counts) (*closure-decisions* closures)) (run)))
        (dolist (pair saved) (setf (symbol-function (car pair)) (cdr pair))))
      (dolist (key '("SHARED-CONTEXT-CACHE-GET" "BUSY-ADD" "BUSY-INSERT"))
        (unless (gethash key counts) (setf (gethash key counts) 0)))
      (bump "CONFIG-SETS" (hash-table-count sets))
      (maphash (lambda (set ignored)
                 (declare (ignore ignored))
                 (bump (format nil "CONFIG-SET-SIZE-~D" (length (cnvrs/runtime:config-set-items set))))) sets)
      (dolist (key (sort (loop for k being the hash-keys of counts collect k) #'string<))
        (format t "COUNT ~A ~D~%" key (gethash key counts)))
      (maphash (lambda (d n) (format t "DECISION ~D CALLS ~D FALLBACKS ~D CLOSURES ~D RULE ~A~%" d n (gethash d fallbacks 0) (gethash d closures 0) (decision-rule d))) decisions)
      (dolist (call (nreverse sequence)) (format t "PREDICT ~{~D~^ ~}~%" call)))))

(counters)

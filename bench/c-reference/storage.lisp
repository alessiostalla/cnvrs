;;; Paired representation measurements; choose the source tree via CWD.
(require :asdf)
(let ((*package* *package*))
  (with-open-file (s "bench/c-reference/benchmark.lisp")
    (loop for form = (read s nil) while form
          until (and (consp form) (eq (first form) 'let*)) do (eval form))))
(in-package #:c-reference/bench)
(let* ((args (uiop:command-line-arguments))
       (source (uiop:read-file-string (second args)))
       (parser *benchmark-parser*)
       (lexer (cnvrs:ensure-compiled (cnvrs:parser-lexer parser)))
       (tokens (cnvrs:lex lexer source))
       (entry 'c-reference/bench/parser::compilationunit)
       (expected (count :default tokens :key #'cnvrs:lexeme-channel)))
  (assert (funcall (cnvrs:parser-runner parser) parser (cnvrs::make-token-input tokens '(:default)) entry t))
  (format t "INPUT ~A TOKENS ~D DEFAULT ~D SIGNATURE ~A KINDS ~A~%"
          (first args) (length tokens) expected (token-signature tokens) (kind-signature tokens))
  (dolist (tree '(:none :node))
    (flet ((run ()
             (setf *sink* (cnvrs:parse parser tokens :lexer nil :rule entry :tree-builder tree))
             (when (eq tree :node) (assert (= expected (cnvrs:node-end *sink*))))))
      (dotimes (i 20) (run))
      (dotimes (trial 3)
        (cnvrs:clear-cache parser) (sb-ext:gc :full t)
        (let ((start (get-internal-real-time)) (cpu (get-internal-run-time)) (bytes (sb-ext:get-bytes-consed)))
          (run)
          (format t "COLD ~A ~D MS ~,6F CPU ~,6F BYTES ~D~%" tree (1+ trial)
                  (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second))
                  (* 1000d0 (/ (- (get-internal-run-time) cpu) internal-time-units-per-second))
                  (- (sb-ext:get-bytes-consed) bytes))))
      (run) (sb-ext:gc :full t)
      (dotimes (batch 7)
        (let ((start (get-internal-real-time)) (cpu (get-internal-run-time)) (bytes (sb-ext:get-bytes-consed)))
          (dotimes (i 20) (run))
          (format t "WARM ~A ~D MS ~,6F CPU ~,6F BYTES ~,1F~%" tree (1+ batch)
                  (/ (* 1000d0 (- (get-internal-real-time) start)) (* 20 internal-time-units-per-second))
                  (/ (* 1000d0 (- (get-internal-run-time) cpu)) (* 20 internal-time-units-per-second))
                  (/ (- (sb-ext:get-bytes-consed) bytes) 20d0)))
        (finish-output))))
  (let ((sim (cnvrs:parser-prediction-simulator parser)))
    (format t "CACHE STATES ~D CONTEXTS ~D~%"
            (reduce #'+ (cnvrs/runtime:simulator-decision-dfas sim) :key (lambda (d) (hash-table-count (cnvrs/runtime:dfa-states d))))
            (loop for bucket being the hash-values of (cnvrs/runtime:simulator-context-cache sim) sum (length bucket)))))

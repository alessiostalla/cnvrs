;;; Diagnostic lookup traffic; wrappers are never active in timing processes.
(require :asdf)
(let ((*package* *package*))
  (with-open-file (input "bench/java-reference/warm-profile.lisp")
    (loop for form = (read input nil nil) while form
          until (and (consp form) (eq (car form) 'dotimes)) do (eval form))))
(dotimes (i 5) (run))
(dolist (phase '(:warm :cold))
  (when (eq phase :cold) (cnvrs:clear-cache *java8-parser*))
  (let ((counts (make-hash-table :test 'equal)) (saved nil))
    (labels ((bump (key &optional (n 1)) (incf (gethash key counts 0) n))
             (wrap (name builder)
               (let ((old (symbol-function name)))
                 (push (cons name old) saved)
                 (setf (symbol-function name) (funcall builder old)))))
      (unwind-protect
           (progn
             (wrap 'cnvrs/runtime:config-set-add
                   (lambda (old)
                     (lambda (set config &rest options)
                       (let* ((key (cnvrs/runtime::config-lookup-hash config))
                              (lookup (cnvrs/runtime::config-set-lookup set))
                              (bucket (when (hash-table-p lookup) (gethash key lookup)))
                              (existing (if (hash-table-p lookup)
                                            (cnvrs/runtime::find-config-in-bucket config bucket)
                                            (funcall (find-symbol "FIND-CONFIG-IN-SET" :cnvrs/runtime) set config))))
                         (bump "CONFIG-ADD")
                         (bump (if (hash-table-p lookup)
                                   (format nil "CONFIG-BUCKET-~D" (length bucket))
                                   (format nil "CONFIG-SET-SIZE-~D" (length (cnvrs/runtime:config-set-items set)))))
                         (when (eq t (cnvrs/runtime:atn-config-semantic config)) (bump "CONFIG-EMPTY-SEMANTIC"))
                         (when existing
                           (bump "CONFIG-HIT")
                           (when (eq (cnvrs/runtime:atn-config-context config)
                                     (cnvrs/runtime:atn-config-context existing)) (bump "CONFIG-EQ-CONTEXT"))))
                       (apply old set config options))))
             (wrap 'cnvrs/runtime::merge-cache-get
                   (lambda (old)
                     (lambda (cache a b wildcard)
                       (bump "MERGE-GET")
                       (let* ((entry (and cache (gethash (logxor (cnvrs/runtime:context-hash a)
                                                                               (cnvrs/runtime:context-hash b)) cache)))
                              (eq-hit (and entry
                                           (let ((x (cnvrs/runtime::merge-cache-entry-a entry))
                                                 (y (cnvrs/runtime::merge-cache-entry-b entry)))
                                             (or (and (eq a x) (eq b y)) (and (eq a y) (eq b x))))))
                              (answer (funcall old cache a b wildcard)))
                         (when answer (bump "MERGE-HIT"))
                         (when eq-hit (bump "MERGE-EQ-PAIR")) answer))))
             (wrap 'cnvrs/runtime::context-cache-get
                   (lambda (old)
                     (lambda (cache context)
                       (bump "CONTEXT-GET")
                       (let ((answer (funcall old cache context)))
                         (when answer (bump "CONTEXT-HIT"))
                         (when (eq answer context) (bump "CONTEXT-EQ")) answer))))
             (run))
        (dolist (entry saved) (setf (symbol-function (car entry)) (cdr entry))))
      (format t "PHASE ~A~%" phase)
      (dolist (key (sort (loop for key being the hash-keys of counts collect key) #'string<))
        (format t "~A ~D~%" key (gethash key counts))))))
(cache-summary *java8-parser*)

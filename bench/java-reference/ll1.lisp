;;; Controlled A/B: Java-style LL(1) dispatch versus always-adaptive execution.
;;; Both variants use the same ATN, compiled rule generator, tokens and process.
(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(defpackage #:ll1/bench (:use #:cl))
(defpackage #:ll1/bench/parser (:use))
(defpackage #:ll1/bench/lexer (:use))
(in-package #:ll1/bench)
(defvar *sink*)
(defun import-grammar (file &rest options)
  (apply #'cnvrs/antlr4:parse (uiop:read-file-string file)
         :parser-package :ll1/bench/parser :lexer-package :ll1/bench/lexer options))
(defun ms-since (start)
  (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
(let* ((iri (equal (first (uiop:command-line-arguments)) "iri"))
       (lexer-definition (unless iri (import-grammar "test/fixtures/runtime/Java8Lexer.g4")))
       (base (cnvrs:ensure-compiled
              (if iri (import-grammar "test/fixtures/IRI.g4")
                  (import-grammar "test/fixtures/runtime/Java8Parser.g4"
                                  :token-vocabulary (list (cons "Java8Lexer" lexer-definition))))))
       (source (uiop:read-file-string (if iri "bench/java-reference/iri.txt" "bench/antlr4-grammar/Bench.java")))
       (tokens (cnvrs:lex (cnvrs:parser-lexer base) source))
       (rule (find-symbol (if iri "PARSE" "COMPILATIONUNIT") :ll1/bench/parser))
       (adaptive (cnvrs:clone-compiled base)) (iterations (if iri 100 2)))
  ;; Never mutate a shared graph. Recompile only this variant's rule functions.
  (setf (cnvrs:parser-states adaptive)
        (map 'vector (lambda (state)
                       (let ((copy (cnvrs::copy-state state)))
                         (setf (cnvrs:state-direct-lookahead copy) nil) copy))
             (cnvrs:parser-states base)))
  (setf (cnvrs:parser-runner adaptive) (cnvrs::compile-parser-runner adaptive nil)
        (cnvrs:parser-node-runner adaptive) (cnvrs::compile-parser-runner adaptive t))
  (format t "GRAMMAR ~A CHARACTERS ~D TOKENS ~D TREE true SBCL ~A~%"
          (if iri "iri" "java8") (length source) (length tokens) (lisp-implementation-version))
  (dotimes (trial 3)
    (dolist (mode (if (oddp trial) '(:ll1 :adaptive) '(:adaptive :ll1)))
      (let ((parser (cnvrs:clone-compiled (if (eq mode :ll1) base adaptive))))
        (cnvrs:parser-prediction-simulator parser)
        (labels ((run ()
                   (setf *sink* (cnvrs:parse parser tokens :lexer nil :rule rule))
                   (assert (= (length tokens) (cnvrs:node-end *sink*)))))
          (sb-ext:gc :full t)
          (let ((bytes (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
            (run)
            (format t "COLD ~A TRIAL ~D MS ~,6F BYTES ~D~%" mode (1+ trial) (ms-since start) (- (sb-ext:get-bytes-consed) bytes)))
          (dotimes (i (if iri 20 3)) (run))
          (dotimes (batch 7)
            (let ((bytes (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
              (dotimes (i iterations) (run))
              (format t "WARM ~A TRIAL ~D BATCH ~D MS ~,6F BYTES ~,1F~%" mode (1+ trial) (1+ batch)
                      (/ (ms-since start) iterations) (/ (- (sb-ext:get-bytes-consed) bytes) (float iterations 1d0)))))
          (format t "CACHE ~A TRIAL ~D STATES ~D~%" mode (1+ trial)
                  (reduce #'+ (cnvrs/runtime:simulator-decision-dfas (cnvrs:parser-prediction-simulator parser))
                          :key (lambda (d) (hash-table-count (cnvrs/runtime:dfa-states d)))))
          (finish-output))))))

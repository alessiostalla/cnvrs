;;; Capture notes explicitly: ASDF's usual diagnostic handlers may muffle them.
(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "cnvrs.asd"))
(asdf:load-system :cnvrs)
(dolist (name '("prediction-context" "atn-config" "parser-atn-simulator" "lexer-atn-simulator"))
  (let ((path (format nil "/tmp/cnvrs-note-source-~A.lisp" name)) (count 0))
    (with-open-file (out path :direction :output :if-exists :supersede)
      (write-line "(declaim (optimize (speed 3) (safety 1) (debug 0) (space 0) (compilation-speed 1)))" out)
      (write-string (uiop:read-file-string (format nil "src/runtime/~A.lisp" name)) out))
    (format t "~&FILE ~A~%" name)
    (handler-bind ((sb-ext:compiler-note (lambda (condition) (incf count) (format t "NOTE ~A~%" condition))))
      (compile-file path :verbose nil :output-file (format nil "/tmp/cnvrs-notes-~A.fasl" name)))
    (format t "COUNT ~A ~D~%" name count)))

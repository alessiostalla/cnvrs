(in-package #:cnvrs/antlr-runtime)

;; Runtime policy is file-local: the standalone ASDF system is compiled before
;; the native frontend. Retain safety checks while optimizing the hot loops.
(declaim (optimize (speed 3) (safety 1) (debug 0) (space 0) (compilation-speed 1)))

(defstruct lexer-config (state 0 :type fixnum) (alt 1 :type fixnum)
  (context (empty-prediction-context) :type (or null prediction-context)) (actions nil :type list) non-greedy)
(defstruct lexer-config-set (items (make-array 0 :adjustable t :fill-pointer 0) :type (vector t))
  (lookup (make-hash-table :test 'equal) :type hash-table) semantic-p)
(defstruct lexer-dfa-state (number 0 :type fixnum) (configs #() :type (vector t)) prediction
  (actions nil :type list) (edges (make-array 128 :initial-element nil) :type simple-vector))
(defstruct lexer-dfa (start nil :type (or null lexer-dfa-state)) (state-count 0 :type fixnum)
  (states (make-hash-table :test 'equal) :type hash-table))
(defstruct (lexer-atn-simulator (:conc-name lexer-simulator-)) (atn (make-atn) :type atn)
  (dfas #() :type simple-vector) (lock (bordeaux-threads:make-lock "ANTLR lexer DFA")))
(define-condition lexer-no-viable-alt (error)
  ((start :initarg :start :reader lexer-error-start)
   (position :initarg :position :reader lexer-error-position)
   (line :initarg :line :reader lexer-error-line)
   (column :initarg :column :reader lexer-error-column)))
(defvar *lexer-simulator*)
(defvar *lexer-source*)
(defvar *lexer-position*)
(defvar *lexer-line*)
(defvar *lexer-column*)
(defvar *lexer-start*)
(defvar *lexer-predicate*)
(defvar *lexer-dfa*)
(defvar *lexer-accept-executor* nil)
(declaim (type lexer-atn-simulator *lexer-simulator*) (type string *lexer-source*)
         (type fixnum *lexer-position* *lexer-line* *lexer-column* *lexer-start*)
         (type lexer-dfa *lexer-dfa*))
(declaim (inline lexer-state-at lexer-consume lexer-lookahead lexer-transition-matches-p))

(defun lexer-clear-dfa (sim)
  (bordeaux-threads:with-lock-held ((lexer-simulator-lock sim))
    (setf (lexer-simulator-dfas sim)
          (map 'vector (lambda (x) (declare (ignore x)) (make-lexer-dfa))
               (atn-decisions (lexer-simulator-atn sim)))))
  sim)
(defun new-lexer-atn-simulator (atn)
  (lexer-clear-dfa (make-lexer-atn-simulator :atn atn)))
(defun lexer-state-at (number) (declare (type fixnum number)) (aref (atn-states (lexer-simulator-atn *lexer-simulator*)) number))
(defun derive-lexer-config (c target &key (context (lexer-config-context c))
                                         (actions (lexer-config-actions c)))
  (make-lexer-config :state target :alt (lexer-config-alt c) :context context :actions actions
                    :non-greedy (or (lexer-config-non-greedy c)
                                    (atn-state-non-greedy-p (lexer-state-at target)))))
(defun lexer-config-key (c)
  (list (lexer-config-state c) (lexer-config-alt c) (context-hash (lexer-config-context c))
        (lexer-config-non-greedy c) (lexer-config-actions c)))
(defun lexer-config-equal (a b)
  (and (equal (lexer-config-key a) (lexer-config-key b))
       (context-equal (lexer-config-context a) (lexer-config-context b))))
(defun lexer-set-add (set config)
  (let ((key (lexer-config-key config)))
    (unless (find config (gethash key (lexer-config-set-lookup set)) :test #'lexer-config-equal)
      (push config (gethash key (lexer-config-set-lookup set)))
      (vector-push-extend config (lexer-config-set-items set)))))
(defun lexer-configs-equal (a b)
  (and (= (length a) (length b)) (every #'lexer-config-equal a b)))
(defun %lexer-intern-state (set)
  ;; Java OrderedATNConfigSet equality preserves configuration insertion order.
  (let* ((configs (lexer-config-set-items set))
         (key (map 'list #'lexer-config-key configs))
         (table (lexer-dfa-states *lexer-dfa*))
         (existing (find configs (gethash key table) :key #'lexer-dfa-state-configs
                         :test #'lexer-configs-equal)))
    (or existing
        (let* ((stop (find-if (lambda (c) (eq (atn-state-kind (lexer-state-at (lexer-config-state c))) :rule-stop)) configs))
               (state (make-lexer-dfa-state
                       :number (lexer-dfa-state-count *lexer-dfa*) :configs configs
                       :prediction (and stop (aref (atn-rule-token-types (lexer-simulator-atn *lexer-simulator*))
                                                   (atn-state-rule (lexer-state-at (lexer-config-state stop)))))
                       :actions (and stop (lexer-config-actions stop)))))
          (incf (lexer-dfa-state-count *lexer-dfa*))
          (push state (gethash key table)) state))))
(defun lexer-intern-state (set)
  (bordeaux-threads:with-lock-held ((lexer-simulator-lock *lexer-simulator*))
    (%lexer-intern-state set)))
(defun lexer-consume ()
  (when (< *lexer-position* (length *lexer-source*))
    (if (char= (char *lexer-source* *lexer-position*) #\Newline)
        (setf *lexer-line* (1+ *lexer-line*) *lexer-column* 0)
        (incf *lexer-column*))
    (incf *lexer-position*)))
(defun lexer-lookahead ()
  (if (< *lexer-position* (length *lexer-source*)) (char-code (char *lexer-source* *lexer-position*)) -1))
(defun lexer-label-contains-p (set code)
  (declare (type fixnum code))
  (some (lambda (range) (<= (the fixnum (first range)) code (the fixnum (second range)))) set))
(defun lexer-transition-matches-p (edge code)
  (declare (type atn-transition edge) (type fixnum code))
  (let ((label (atn-transition-label edge)))
    (case (atn-transition-kind edge)
      (:atom (= (the fixnum label) code))
      (:range (<= (the fixnum (first label)) code (the fixnum (second label))))
      (:set (lexer-label-contains-p label code))
      (:not-set (and (<= 0 code #x10ffff) (not (lexer-label-contains-p label code))))
      (:wildcard (<= 0 code #x10ffff)))))
(defun lexer-fix-action-offset (actions offset)
  (mapcar (lambda (action)
            (if (eq (first action) :custom) (list :indexed offset action) action)) actions))
(defun lexer-evaluate-predicate (label speculative)
  (if (null *lexer-predicate*) t
      (if (not speculative) (funcall *lexer-predicate* label *lexer-position* *lexer-line* *lexer-column*)
          (let ((*lexer-position* *lexer-position*) (*lexer-line* *lexer-line*) (*lexer-column* *lexer-column*))
            (lexer-consume)
            (funcall *lexer-predicate* label *lexer-position* *lexer-line* *lexer-column*)))))
(defun lexer-epsilon-target (config edge set speculative eof-as-epsilon)
  (let ((target (atn-transition-target edge)))
    (case (atn-transition-kind edge)
      (:rule (derive-lexer-config config target
                                 :context (singleton-context (lexer-config-context config) (atn-transition-follow edge))))
      (:predicate
       (setf (lexer-config-set-semantic-p set) t)
       (when (lexer-evaluate-predicate (atn-transition-label edge) speculative)
         (derive-lexer-config config target)))
      (:action
       (derive-lexer-config
        config target :actions
        (if (or (null (lexer-config-context config)) (context-has-empty-path-p (lexer-config-context config)))
            (append (lexer-config-actions config)
                    (list (aref (atn-lexer-actions (lexer-simulator-atn *lexer-simulator*)) (atn-transition-label edge))))
            (lexer-config-actions config))))
      (:epsilon (derive-lexer-config config target))
      (:precedence (error "Precedence predicates are not supported in lexers"))
      ((:atom :range :set)
       (when (and eof-as-epsilon (lexer-transition-matches-p edge -1)) (derive-lexer-config config target))))))
(defun lexer-closure (config set accepted speculative eof-as-epsilon)
  (let* ((state (lexer-state-at (lexer-config-state config))) (context (lexer-config-context config)))
    (when (eq (atn-state-kind state) :rule-stop)
      (when (or (null context) (context-has-empty-path-p context))
        (if (or (null context) (empty-context-p context))
            (progn (lexer-set-add set config) (return-from lexer-closure t))
            (progn (lexer-set-add set (derive-lexer-config config (lexer-config-state config)
                                                         :context (empty-prediction-context)))
                   (setf accepted t))))
      (when (and context (not (empty-context-p context)))
        (loop for ret across (context-return-states context)
              for parent across (context-parents context)
              unless (= ret +empty-return-state+) do
                (setf accepted (lexer-closure (derive-lexer-config config ret :context parent)
                                               set accepted speculative eof-as-epsilon))))
      (return-from lexer-closure accepted))
    (unless (and (atn-state-transitions state)
                 (every (lambda (e) (member (atn-transition-kind e) '(:rule :predicate :action :epsilon :precedence)))
                        (atn-state-transitions state)))
      (unless (and accepted (lexer-config-non-greedy config)) (lexer-set-add set config)))
    (dolist (edge (atn-state-transitions state))
      (let ((next (lexer-epsilon-target config edge set speculative eof-as-epsilon)))
        (when next (setf accepted (lexer-closure next set accepted speculative eof-as-epsilon)))))
    accepted))
(defun lexer-compute-start (mode)
  (let ((set (make-lexer-config-set))
        (start (lexer-state-at (aref (atn-mode-starts (lexer-simulator-atn *lexer-simulator*)) mode))))
    (loop for edge in (atn-state-transitions start) for alt from 1 do
      (lexer-closure (make-lexer-config :state (atn-transition-target edge) :alt alt)
                     set nil nil nil))
    set))
(defun lexer-compute-target (state code)
  (declare (type lexer-dfa-state state) (type fixnum code))
  (let ((reach (make-lexer-config-set)) (skip-alt nil))
    (loop for c across (lexer-dfa-state-configs state)
          for accepted = (eql (lexer-config-alt c) skip-alt)
          unless (and accepted (lexer-config-non-greedy c)) do
            (dolist (edge (atn-state-transitions (lexer-state-at (lexer-config-state c))))
              (when (lexer-transition-matches-p edge code)
                (let ((next (derive-lexer-config c (atn-transition-target edge)
                                                :actions (lexer-fix-action-offset
                                                          (lexer-config-actions c)
                                                          (- *lexer-position* *lexer-start*)))))
                  (when (lexer-closure next reach accepted t (= code -1))
                    (setf skip-alt (lexer-config-alt c)) (return))))))
    (let* ((suppress (lexer-config-set-semantic-p reach))
           (target (if (zerop (length (lexer-config-set-items reach))) :error
                       (lexer-intern-state reach))))
      (unless (or suppress (< code 0) (> code 127))
        (bordeaux-threads:with-lock-held ((lexer-simulator-lock *lexer-simulator*))
          (setf (aref (lexer-dfa-state-edges state) code) target)))
      target)))
(defun lexer-match (sim source position mode &key (line 1) (column 0) predicate action)
  "Reference match with an invocation-local cursor; returns type, end, line, column.
ACTION receives the accepted executor, token start, and end, after cursor rewind."
  (let* ((*lexer-simulator* sim) (*lexer-source* source) (*lexer-position* position)
         (*lexer-start* position) (*lexer-line* line) (*lexer-column* column)
         (*lexer-predicate* predicate))
    ;; As in Java, only DFA interning and edge publication hold locks.
    ;; Predicates and user actions may reenter a shared grammar.
    (progn
      (let* ((*lexer-dfa* (aref (lexer-simulator-dfas sim) mode))
             (state (or (lexer-dfa-start *lexer-dfa*)
                        (let* ((configs (lexer-compute-start mode))
                               (start (lexer-intern-state configs)))
                          (unless (lexer-config-set-semantic-p configs)
                            (bordeaux-threads:with-lock-held ((lexer-simulator-lock sim))
                              (setf (lexer-dfa-start *lexer-dfa*) start))) start)))
             (previous nil))
        (labels ((capture () (setf previous (list state *lexer-position* *lexer-line* *lexer-column*))))
          (when (lexer-dfa-state-prediction state) (capture))
          (loop for code = (lexer-lookahead)
                for target = (or (and (<= 0 code 127) (aref (lexer-dfa-state-edges state) code))
                                 (lexer-compute-target state code))
                until (eq target :error) do
                  (unless (= code -1) (lexer-consume))
                  (setf state target)
                  (when (lexer-dfa-state-prediction state) (capture) (when (= code -1) (return))))
          (cond (previous
                 (destructuring-bind (accept end accepted-line accepted-column) previous
                   (when (or action *lexer-accept-executor*)
                     (funcall (or action *lexer-accept-executor*) (lexer-dfa-state-actions accept) position end))
                   (values (lexer-dfa-state-prediction accept) end accepted-line accepted-column)))
                ((and (= (lexer-lookahead) -1) (= *lexer-position* position))
                 (values -1 position *lexer-line* *lexer-column*))
                (t (error 'lexer-no-viable-alt :start position :position *lexer-position*
                          :line *lexer-line* :column *lexer-column*))))))))

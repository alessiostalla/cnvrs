;;; Port of ParserATNSimulator and DFA/DFAState, ANTLR Java 4.13.2.
;;; Method names follow the Java source; grammar frontends supply a typed ATN.
(in-package #:cnvrs/antlr-runtime)

;; Runtime policy is file-local: the standalone ASDF system is compiled before
;; the native frontend. Retain safety checks while optimizing the hot loops.
(declaim (optimize (speed 3) (safety 1) (debug 0) (space 0) (compilation-speed 1)))

(define-condition no-viable-alt (error)
  ((decision :initarg :decision :reader failed-decision)
   (position :initarg :position :reader failed-position)
   (start-index :initarg :start-index :reader failed-start-index)
   (configs :initarg :configs :reader failed-configs)))
(defstruct dfa-state (configs (make-atn-config-set) :type atn-config-set) (edges (make-hash-table :test 'eql) :type hash-table)
  (lock (bordeaux-threads:make-lock "ANTLR DFA edges"))
  accept-p (prediction nil :type (or null fixnum)) requires-full-context predicates)
(defstruct dfa (decision 0 :type fixnum) (start-state 0 :type fixnum) (start nil :type (or null dfa-state))
  (lock (bordeaux-threads:make-lock "ANTLR DFA states"))
  (states (make-hash-table :test 'equal) :type hash-table)
  (precedence-starts (make-hash-table :test 'eql) :type hash-table))
(defstruct (parser-atn-simulator (:conc-name simulator-)
             (:constructor %make-parser-atn-simulator))
  (atn (make-atn) :type atn) (decision-dfas #() :type simple-vector)
  (context-cache (make-context-cache) :type hash-table)
  (mode :ll) predicate-evaluator precedence-evaluator trace
  (context-cache-lock (bordeaux-threads:make-lock "ANTLR shared context cache")))
(defvar *simulator* nil)
(defvar *input* #())
(defvar *start-index* 0)
(defvar *outer-context* nil)
(defvar *precedence* 0)
(defvar *current-dfa* nil)
(declaim (type (or null parser-atn-simulator) *simulator*)
         (type (vector t) *input*) (type fixnum *start-index* *precedence*)
         (type (or null dfa) *current-dfa*))
(declaim (inline get-state rule-stop-p epsilon-transition-p epsilon-only-p transition-matches-p input-la))

(defun make-parser-atn-simulator (atn &key (mode :ll) predicate-evaluator
                                          precedence-evaluator trace)
  (unless (member mode '(:sll :ll :ll-exact-ambig-detection))
    (error "Unknown ANTLR prediction mode: ~S" mode))
  (%make-parser-atn-simulator
   :atn atn :mode mode :predicate-evaluator predicate-evaluator
   :precedence-evaluator precedence-evaluator :trace trace
   :decision-dfas
   (coerce (loop for id across (atn-decisions atn) for decision from 0
                 collect (make-dfa :decision decision :start-state id)) 'vector)))
(defun clear-dfa (simulator)
  (setf (simulator-decision-dfas simulator)
        (coerce (loop for id across (atn-decisions (simulator-atn simulator)) for decision from 0
                     collect (make-dfa :decision decision :start-state id)) 'vector))
  simulator)
(defun runtime-trace (event &rest data)
  (when (simulator-trace *simulator*)
    (funcall (simulator-trace *simulator*) event data)))
(defun get-state (id) (declare (type fixnum id)) (aref (atn-states (simulator-atn *simulator*)) id))
(defun rule-stop-p (id) (eq (atn-state-kind (get-state id)) :rule-stop))
(defun epsilon-transition-p (transition)
  (member (atn-transition-kind transition) '(:epsilon :rule :predicate :action :precedence)))
(defun epsilon-only-p (state)
  (and (atn-state-transitions state)
       (every #'epsilon-transition-p (atn-state-transitions state))))
(defun transition-matches-p (transition token)
  (declare (type atn-transition transition) (type fixnum token))
  (let ((label (atn-transition-label transition)))
    (case (atn-transition-kind transition)
      (:atom (eql token label))
      (:range (<= (the fixnum (car label)) token (the fixnum (cdr label))))
      (:set (member token label))
      (:not-set (and (<= 0 token (atn-max-token-type (simulator-atn *simulator*)))
                     (not (member token label))))
      (:wildcard (<= 0 token (atn-max-token-type (simulator-atn *simulator*)))))))
(defun semantic-eval (semantic)
  (cond ((eq semantic t) t) ((null semantic) nil)
        ((eq (car semantic) :and) (every #'semantic-eval (cdr semantic)))
        ((eq (car semantic) :or) (some #'semantic-eval (cdr semantic)))
        ((eq (car semantic) :precedence)
         (if (simulator-precedence-evaluator *simulator*)
             (funcall (simulator-precedence-evaluator *simulator*) (second semantic) *precedence*)
             (>= (second semantic) *precedence*)))
        (t
         (unless (simulator-predicate-evaluator *simulator*)
           (error "Predicate evaluator required for ~S" semantic))
         (funcall (simulator-predicate-evaluator *simulator*) semantic
                  *input* *start-index* *outer-context*))))
(defun eval-precedence (semantic)
  (cond ((eq semantic t) t)
        ((eq (car semantic) :precedence) (and (semantic-eval semantic) t))
        ((member (car semantic) '(:and :or))
         (let* ((operator (car semantic))
                (parts (mapcar #'eval-precedence (cdr semantic))))
           (cond ((eq operator :and)
                  (and (every #'identity parts)
                       (reduce (lambda (a b) (semantic-operator :and a b)) parts :initial-value t)))
                 ((member t parts) t)
                 (t (reduce (lambda (a b) (semantic-operator :or a b)) parts :initial-value nil)))))
        (t semantic)))
(defun get-epsilon-target (config transition collect-predicates in-context full-context eof-as-epsilon)
  (let ((target (atn-transition-target transition)))
    (case (atn-transition-kind transition)
      (:rule (derive-config config target
                            :context (singleton-context (atn-config-context config)
                                                        (atn-transition-follow transition))))
      ((:epsilon :action) (derive-config config target))
      ((:predicate :precedence)
       (let* ((precedence-p (eq (atn-transition-kind transition) :precedence))
              (predicate (if precedence-p (list :precedence (atn-transition-label transition))
                             (atn-transition-label transition)))
              (collect (and collect-predicates
                            (if precedence-p in-context
                                (or (not (atn-transition-context-dependent-p transition)) in-context)))))
         (cond ((not collect) (derive-config config target))
               (full-context (and (semantic-eval predicate) (derive-config config target)))
               (t (derive-config config target
                                 :semantic (semantic-operator :and (atn-config-semantic config) predicate))))))
      ((:atom :range :set)
       (when (and eof-as-epsilon (transition-matches-p transition -1))
         (derive-config config target)))
      ((:not-set :wildcard) nil)
      (otherwise (error "Unsupported ATN transition: ~S" (atn-transition-kind transition))))))
(defun config-equal (a b)
  (and (= (atn-config-state a) (atn-config-state b))
       (= (atn-config-alt a) (atn-config-alt b))
       (equal (atn-config-semantic a) (atn-config-semantic b))
       (eql (atn-config-precedence-filter-suppressed-p a)
            (atn-config-precedence-filter-suppressed-p b))
       (context-equal (atn-config-context a) (atn-config-context b))))
(defun busy-add (busy config)
  (let ((key (list (atn-config-state config) (atn-config-alt config)
                    (context-hash (atn-config-context config)) (atn-config-semantic config))))
    (unless (find config (gethash key busy) :test #'config-equal)
      (push config (gethash key busy)) t)))
(defun can-drop-loop-entry-edge-in-left-recursive-rule (config)
  (let* ((p (get-state (atn-config-state config))) (context (atn-config-context config)))
    (unless (and (eq (atn-state-kind p) :star-loop-entry)
                 (atn-state-precedence-decision-p p)
                 (not (context-has-empty-path-p context)))
      (return-from can-drop-loop-entry-edge-in-left-recursive-rule nil))
    (let* ((decision (get-state (atn-transition-target (first (atn-state-transitions p)))))
           (end (atn-state-end-state decision)))
      (loop for id across (context-return-states context)
            for state = (get-state id) for edges = (atn-state-transitions state)
            always (and (= (atn-state-rule state) (atn-state-rule p))
                        (= (length edges) 1) (epsilon-transition-p (first edges))
                        (let* ((target-id (atn-transition-target (first edges)))
                               (target (get-state target-id))
                               (next (atn-state-transitions target)))
                          (or (= id end) (= target-id end)
                              (and (eq (atn-state-kind state) :block-end)
                                   (= target-id (atn-state-number p)))
                              (and (eq (atn-state-kind target) :block-end)
                                   (= (length next) 1) (epsilon-transition-p (first next))
                                   (= (atn-transition-target (first next)) (atn-state-number p))))))))))

(defun closure-checking-stop-state (config configs busy collect-predicates full-context depth eof-as-epsilon)
  (declare (type atn-config config) (type atn-config-set configs) (type hash-table busy) (type fixnum depth))
  (when (rule-stop-p (atn-config-state config))
    (let ((context (atn-config-context config)))
      (cond ((not (empty-context-p context))
             (loop for return-state across (context-return-states context)
                   for parent across (context-parents context) do
               (cond ((= return-state +empty-return-state+)
                      (if full-context
                          (config-set-add configs (derive-config config (atn-config-state config)
                                                               :context (empty-prediction-context)))
                          (closure-work config configs busy collect-predicates full-context depth eof-as-epsilon)))
                     (t (closure-checking-stop-state
                         (derive-config config return-state :context parent)
                         configs busy collect-predicates full-context (1- depth) eof-as-epsilon))))
             (return-from closure-checking-stop-state))
            (full-context (config-set-add configs config)
                          (return-from closure-checking-stop-state)))))
  (closure-work config configs busy collect-predicates full-context depth eof-as-epsilon))
(defun closure-work (config configs busy collect-predicates full-context depth eof-as-epsilon)
  (declare (type atn-config config) (type atn-config-set configs) (type hash-table busy) (type fixnum depth))
  (let ((state (get-state (atn-config-state config))))
    (unless (epsilon-only-p state) (config-set-add configs config))
    (loop for transition in (atn-state-transitions state) for index from 0 do
      (unless (and (zerop index) (can-drop-loop-entry-edge-in-left-recursive-rule config))
        (let* ((collect (and collect-predicates (not (eq (atn-transition-kind transition) :action))))
               (next (get-epsilon-target config transition collect (zerop depth) full-context eof-as-epsilon))
               (new-depth depth))
          (when next
            (cond ((eq (atn-state-kind state) :rule-stop)
                   (when (and *current-dfa*
                              (atn-state-precedence-decision-p (get-state (dfa-start-state *current-dfa*)))
                              (= (atn-transition-outermost-precedence-return transition)
                                 (atn-state-rule (get-state (dfa-start-state *current-dfa*)))))
                     (setf (atn-config-precedence-filter-suppressed-p next) t))
                   (incf (atn-config-outer-depth next))
                   (unless (busy-add busy next) (setf next nil))
                   (setf (config-set-dips-into-outer-context configs) t)
                   (decf new-depth))
                  (t
                   (when (and (not (epsilon-transition-p transition)) (not (busy-add busy next)))
                     (setf next nil))
                   (when (and (eq (atn-transition-kind transition) :rule) (>= new-depth 0))
                     (incf new-depth))))
            (when next (closure-checking-stop-state next configs busy collect full-context new-depth eof-as-epsilon))))))))
(defun atn-closure (config configs busy collect-predicates full-context eof-as-epsilon)
  (closure-checking-stop-state config configs busy collect-predicates full-context 0 eof-as-epsilon))
(defun compute-start-state (simulator decision initial-context full-context)
  (let ((*simulator* simulator) (configs (make-atn-config-set :full-context full-context)))
    (loop for edge in (atn-state-transitions (get-state decision)) for alt from 1 do
      (atn-closure (make-atn-config :state (atn-transition-target edge) :alt alt :context initial-context)
                   configs (make-hash-table :test 'equal) t full-context nil))
    configs))
(defun compute-reach-set (simulator closure token full-context)
  (declare (type parser-atn-simulator simulator) (type atn-config-set closure) (type fixnum token))
  (unless *merge-cache* (setf *merge-cache* (make-hash-table :test 'eql)))
  (let* ((*simulator* simulator) (atn (simulator-atn simulator))
         (intermediate (make-atn-config-set :full-context full-context))
         (skipped nil) (reach nil))
    (loop for c across (config-set-items closure) do
      (if (stop-config-p atn c)
          (when (or full-context (= token -1)) (push c skipped))
          (dolist (edge (atn-state-transitions (get-state (atn-config-state c))))
            (when (transition-matches-p edge token)
              (config-set-add intermediate (derive-config c (atn-transition-target edge)))))))
    (when (and (null skipped) (/= token -1)
               (or (= (length (config-set-items intermediate)) 1) (unique-alt intermediate)))
      (setf reach intermediate))
    (unless reach
      (setf reach (make-atn-config-set :full-context full-context))
      (let ((busy (make-hash-table :test 'equal)))
        (loop for c across (config-set-items intermediate) do
          (atn-closure c reach busy nil full-context (= token -1)))))
    ;; Java removeAllConfigsNotInRuleStopState. EOF always takes closure above,
    ;; so lookToEndOfRule is false here, including explicit EOF transitions.
    (when (= token -1)
      (let ((stops (make-atn-config-set :full-context full-context)))
        (loop for c across (config-set-items reach) when (stop-config-p atn c) do (config-set-add stops c))
        (setf reach stops)))
    (when (and skipped (or (not full-context)
                           (notany (lambda (c) (stop-config-p atn c)) (config-set-items reach))))
      (dolist (c (nreverse skipped)) (config-set-add reach c)))
    (runtime-trace :reach :full-context full-context :token token :configs (length (config-set-items reach)))
    (when (plusp (length (config-set-items reach))) reach)))

(defun apply-precedence-filter (configs)
  (let ((from-alt1 (make-hash-table))
        (result (make-atn-config-set :full-context (config-set-full-context configs))))
    (loop for c across (config-set-items configs) when (= (atn-config-alt c) 1) do
      (let ((updated (eval-precedence (atn-config-semantic c))))
        (when updated
          (setf (gethash (atn-config-state c) from-alt1) (atn-config-context c))
          (config-set-add result (derive-config c (atn-config-state c) :semantic updated)))))
    (loop for c across (config-set-items configs) unless (= (atn-config-alt c) 1) do
      (unless (and (not (atn-config-precedence-filter-suppressed-p c))
                   (context-equal (gethash (atn-config-state c) from-alt1) (atn-config-context c)))
        (config-set-add result c)))
    result))
(defun add-dfa-state (dfa state)
  (bordeaux-threads:with-lock-held ((dfa-lock dfa))
    (bordeaux-threads:with-lock-held ((simulator-context-cache-lock *simulator*))
      (%add-dfa-state dfa state))))
(defun %add-dfa-state (dfa state)
  (let ((configs (dfa-state-configs state)) (visited (make-hash-table :test 'eq)))
    ;; ATNConfigSet.optimizeConfigs + setReadonly. Only SLL DFA contexts enter
    ;; this persistent cache; LL reach sets and mergeCache are prediction-local.
    (loop for c across (config-set-items configs) do
      (setf (atn-config-context c) (cached-context (atn-config-context c)
                                                  (simulator-context-cache *simulator*) visited)))
    (let ((key (list (config-set-full-context configs) (config-set-unique-alt configs)
                     (config-set-conflicting-alts configs) (config-set-has-semantic-context configs)
                     (config-set-dips-into-outer-context configs)
                     (map 'list (lambda (c) (list (atn-config-state c) (atn-config-alt c)
                                                  (atn-config-context c) (atn-config-semantic c)
                                                  (atn-config-precedence-filter-suppressed-p c)))
                          (config-set-items configs)))))
      (or (gethash key (dfa-states dfa))
          (progn (setf (config-set-read-only-p configs) t (config-set-lookup configs) nil)
                 (setf (gethash key (dfa-states dfa)) state))))))
(defun predicate-dfa-state (state)
  (let* ((configs (dfa-state-configs state))
         (alts (or (and (config-set-unique-alt configs) (list (config-set-unique-alt configs)))
                   (coerce (config-set-conflicting-alts configs) 'list)))
         (predicates (make-hash-table)))
    (loop for c across (config-set-items configs) when (member (atn-config-alt c) alts) do
      (setf (gethash (atn-config-alt c) predicates)
            (semantic-operator :or (gethash (atn-config-alt c) predicates) (atn-config-semantic c))))
    (when (loop for p being the hash-values of predicates thereis (not (eq p t)))
      (setf (dfa-state-predicates state) (loop for alt in alts collect (cons (gethash alt predicates) alt))
            (dfa-state-prediction state) nil))))
(defun get-existing-target-state (previous token)
  (bordeaux-threads:with-lock-held ((dfa-state-lock previous))
    (gethash token (dfa-state-edges previous))))
(defun add-dfa-edge (previous token target)
  (when (<= -1 token (atn-max-token-type (simulator-atn *simulator*)))
    (bordeaux-threads:with-lock-held ((dfa-state-lock previous))
      (setf (gethash token (dfa-state-edges previous)) target)))
  target)
(defun compute-target-state (dfa previous token)
  (let ((reach (compute-reach-set *simulator* (dfa-state-configs previous) token nil)))
    (unless reach (add-dfa-edge previous token :error)
                  (return-from compute-target-state :error))
    (let* ((state (make-dfa-state :configs reach)) (unique (unique-alt reach)))
      (cond (unique (setf (config-set-unique-alt reach) unique
                           (dfa-state-accept-p state) t (dfa-state-prediction state) unique))
            ((has-sll-conflict-terminating-prediction (simulator-atn *simulator*) reach (simulator-mode *simulator*))
             (setf (config-set-conflicting-alts reach) (coerce (config-set-alternatives reach) 'vector)
                   (dfa-state-requires-full-context state) t (dfa-state-accept-p state) t
                   (dfa-state-prediction state) (first (config-set-alternatives reach)))))
      (when (and (dfa-state-accept-p state) (config-set-has-semantic-context reach))
        (predicate-dfa-state state))
      (setf state (add-dfa-state dfa state))
      (add-dfa-edge previous token state))))
(defun alt-that-finished-decision-entry-rule (configs)
  (let ((valid nil) (invalid nil))
    (loop for c across (config-set-items configs)
          for semantically-valid = (semantic-eval (atn-config-semantic c))
          when (or (plusp (atn-config-outer-depth c))
                   (and (rule-stop-p (atn-config-state c)) (context-has-empty-path-p (atn-config-context c)))) do
      (if semantically-valid (push (atn-config-alt c) valid) (push (atn-config-alt c) invalid)))
    (let ((alts (or valid invalid))) (and alts (reduce #'min alts)))))
(defun no-alt (dfa configs &optional (position *start-index*))
  (error 'no-viable-alt :decision (dfa-decision dfa) :position position
                       :start-index *start-index* :configs configs))
(defun input-la (position)
  (declare (type fixnum position))
  (if (< position (length *input*)) (the fixnum (aref *input* position)) -1))
(defun exec-atn-with-full-context (dfa start)
  (let ((previous start) (position *start-index*))
    (loop
      (let* ((token (input-la position))
             (reach (compute-reach-set *simulator* previous token t)))
        (unless reach
          (return (or (alt-that-finished-decision-entry-rule previous) (no-alt dfa previous position))))
        (let* ((subsets (conflicting-alt-subsets reach)) (unique (unique-alt reach))
               (answer (or unique
                           (if (eq (simulator-mode *simulator*) :ll-exact-ambig-detection)
                               (and (every #'cdr subsets) (every (lambda (s) (equal s (first subsets))) subsets)
                                    (single-viable-alt subsets))
                               (single-viable-alt subsets)))))
          (when answer
            (runtime-trace (if unique :context-sensitivity :ambiguity) :decision (dfa-decision dfa)
                           :start *start-index* :stop position :alternative answer)
            (return answer)))
        (setf previous reach)
        (unless (= token -1) (incf position))))))
(defun evaluate-predictions (state)
  (loop for (predicate . alt) in (dfa-state-predicates state)
        when (semantic-eval predicate) collect alt))
(defun prediction-context-from-outer-context (context)
  ;; Frontend adaptation of PredictionContext.fromRuleContext: a Lisp caller
  ;; stack already contains the follow-state numbers Java obtains from ATN
  ;; rule transitions. Conversion happens only on full-context fallback.
  (etypecase context
    (prediction-context context)
    (list (context-from-stack context))))
(defun exec-atn (dfa start)
  (let ((previous start) (position *start-index*))
    (loop
      (let* ((token (input-la position))
             (next (or (get-existing-target-state previous token) (compute-target-state dfa previous token))))
        (when (eq next :error)
          (return (or (alt-that-finished-decision-entry-rule (dfa-state-configs previous))
                      (no-alt dfa (dfa-state-configs previous) position))))
        (when (and (dfa-state-requires-full-context next) (not (eq (simulator-mode *simulator*) :sll)))
          (let ((alts (and (dfa-state-predicates next) (evaluate-predictions next))))
            (when (and alts (null (cdr alts))) (return (first alts))))
          (runtime-trace :attempting-full-context :decision (dfa-decision dfa) :start *start-index* :stop position)
          (return (exec-atn-with-full-context dfa
                     (compute-start-state *simulator* (dfa-start-state dfa)
                                          (prediction-context-from-outer-context *outer-context*) t))))
        (when (dfa-state-accept-p next)
          (return (if (dfa-state-predicates next)
                      (or (first (evaluate-predictions next)) (no-alt dfa (dfa-state-configs next)))
                      (dfa-state-prediction next))))
        (setf previous next)
        (unless (= token -1) (incf position))))))
(defun adaptive-predict (simulator tokens decision &key (position 0) outer-context (precedence 0))
  "ParserATNSimulator.adaptivePredict. TOKENS are positive types; EOF is -1.
The input is immutable; cursor restoration is implicit. Alternatives are one-based.
OUTER-CONTEXT is a nearest-first caller follow-state list or a prediction context."
  (declare (type parser-atn-simulator simulator) (type (vector t) tokens)
           (type fixnum decision position precedence))
  (let* ((*simulator* simulator) (*input* tokens) (*start-index* position)
         (*outer-context* (or outer-context (empty-prediction-context))) (*precedence* precedence)
         (*merge-cache* nil)
         (*current-dfa* (aref (simulator-decision-dfas simulator) decision))
         (precedence-p (atn-state-precedence-decision-p (get-state (dfa-start-state *current-dfa*))))
         (start (bordeaux-threads:with-lock-held ((dfa-lock *current-dfa*))
                  (if precedence-p (gethash precedence (dfa-precedence-starts *current-dfa*))
                      (dfa-start *current-dfa*)))))
    (unless start
      (setf start (compute-start-state simulator (dfa-start-state *current-dfa*) (empty-prediction-context) nil))
      (when precedence-p (setf start (apply-precedence-filter start)))
      (setf start (add-dfa-state *current-dfa* (make-dfa-state :configs start)))
      (bordeaux-threads:with-lock-held ((dfa-lock *current-dfa*))
        (if precedence-p (setf (gethash precedence (dfa-precedence-starts *current-dfa*)) start)
            (setf (dfa-start *current-dfa*) start))))
    (exec-atn *current-dfa* start)))

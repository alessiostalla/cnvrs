(in-package #:cnvrs)

#+sbcl (declaim (optimize (speed 3) (safety 1) (debug 0)
                           (space 0) (compilation-speed 0)))

(defstruct compiled-lexer states mode-starts kinds skips channels ordered-rules
  push-modes pop-modes set-modes metadata cache-backend cache function matcher)

(define-condition lexical-error (error)
  ((position :initarg :position :reader lexical-error-position)
   (character :initarg :character :reader lexical-error-character))
  (:report (lambda (condition stream)
             (format stream "No lexer rule matches ~S at character ~D"
                     (lexical-error-character condition)
                     (lexical-error-position condition)))))

(define-condition lexer-mode-error (lexical-error)
  ((mode :initarg :mode :reader lexer-mode-error-mode))
  (:report (lambda (condition stream)
             (format stream "Cannot pop lexer mode ~S at character ~D: mode stack is empty"
                     (lexer-mode-error-mode condition)
                     (lexical-error-position condition)))))

(defstruct (lx-state (:include graph-state)) accept)
(defstruct lx-dfa-state active best-rule edges
  (lock (bt:make-lock "CNVRS lexer DFA state")))

(defun lx-new-state (states)
  (graph-new-state states (lambda (id) (make-lx-state :id id))))

(defun lx-edge (states from kind target &optional value)
  (graph-add-edge states from kind target value))

(declaim (inline lx-edge-kind lx-edge-target lx-edge-value))
(defun lx-edge-kind (edge) (transition-kind edge))
(defun lx-edge-target (edge) (transition-target edge))
(defun lx-edge-value (edge) (transition-value edge))

(defun lx-kind (form)
  (cond ((or (characterp form) (stringp form)) :literal)
        ((symbolp form) :reference)
        ((and (consp form) (symbolp (first form)))
         (let ((name (string-upcase (symbol-name (first form)))))
           (cond ((member name '("AND" "SEQ") :test #'string=) :sequence)
                 ((string= name "OR") :choice)
                 ((string= name "*") :star)
                 ((string= name "+") :plus)
                 ((string= name "?") :optional)
                 ((string= name "*?") :lazy-star)
                 ((string= name "+?") :lazy-plus)
                 ((string= name "??") :lazy-optional)
                 ((string= name "RANGE") :range)
                 ((string= name "ONE-OF") :one-of)
                 ((string= name "NOT-ONE-OF") :not-one-of)
                 ((string= name "ANY") :any)
                 ((string= name "PREDICATE") :predicate)
                 ((string= name "ACTION") :action))))
        (t nil)))

(defvar *lx-after-nongreedy* nil)
(defvar *lx-action-events* nil)
(defvar *lx-suppress-actions* nil)

(defclass lx-expr ()
  ((source :initarg :source :reader lx-expr-source)))
(defclass lx-reference-expr (lx-expr)
  ((name :initarg :name :reader lx-expr-name)))
(defclass lx-literal-expr (lx-expr)
  ((text :initarg :text :reader lx-expr-text)))
(defclass lx-range-expr (lx-expr)
  ((lower :initarg :lower :reader lx-expr-lower)
   (upper :initarg :upper :reader lx-expr-upper)))
(defclass lx-characters-expr (lx-expr)
  ((items :initarg :items :reader lx-expr-items)))
(defclass lx-one-of-expr (lx-characters-expr) ())
(defclass lx-not-one-of-expr (lx-characters-expr) ())
(defclass lx-any-expr (lx-expr) ())
(defclass lx-callback-expr (lx-expr)
  ((callback :initarg :callback :reader lx-expr-callback)))
(defclass lx-predicate-expr (lx-callback-expr) ())
(defclass lx-action-expr (lx-callback-expr) ())
(defclass lx-sequence-expr (lx-expr)
  ((parts :initarg :parts :reader lx-expr-parts)))
(defclass lx-choice-expr (lx-sequence-expr) ())
(defclass lx-unary-expr (lx-expr)
  ((body :initarg :body :reader lx-expr-body)))
(defclass lx-optional-expr (lx-unary-expr) ())
(defclass lx-star-expr (lx-unary-expr) ())
(defclass lx-plus-expr (lx-unary-expr) ())
(defclass lx-lazy-optional-expr (lx-optional-expr) ())
(defclass lx-lazy-star-expr (lx-star-expr) ())
(defclass lx-lazy-plus-expr (lx-plus-expr) ())

(defun lx-expression-from-form (form)
  "Convert and check a lexer form before compilation or matching."
  (let ((kind (lx-kind form)))
    (unless kind (grammar-fail "Invalid lexer expression: ~S" form))
    (flet ((unary (class)
             (unless (= (length form) 2)
               (grammar-fail "~A requires one lexer expression: ~S"
                             (first form) form))
             (make-instance class :source form
                                  :body (lx-expression-from-form (second form)))))
      (case kind
        (:reference (make-instance 'lx-reference-expr :source form :name form))
        (:predicate (make-instance 'lx-predicate-expr :source form
                                   :callback (semantic-callback form)))
        (:action (make-instance 'lx-action-expr :source form
                                :callback (semantic-callback form)))
        (:literal (make-instance 'lx-literal-expr :source form :text (string form)))
        (:sequence
         (make-instance 'lx-sequence-expr :source form
                       :parts (mapcar #'lx-expression-from-form (rest form))))
        (:choice
         (unless (rest form)
           (grammar-fail "OR requires at least one lexer alternative"))
         (make-instance 'lx-choice-expr :source form
                       :parts (mapcar #'lx-expression-from-form (rest form))))
        (:optional (unary 'lx-optional-expr))
        (:star (unary 'lx-star-expr))
        (:plus (unary 'lx-plus-expr))
        (:lazy-optional (unary 'lx-lazy-optional-expr))
        (:lazy-star (unary 'lx-lazy-star-expr))
        (:lazy-plus (unary 'lx-lazy-plus-expr))
        (:range
         (unless (and (= (length form) 3)
                      (characterp (second form)) (characterp (third form))
                      (char<= (second form) (third form)))
           (grammar-fail "RANGE requires ordered character bounds: ~S" form))
         (make-instance 'lx-range-expr :source form :lower (second form)
                                       :upper (third form)))
        (:one-of
         (unless (and (= (length form) 2) (stringp (second form))
                      (plusp (length (second form))))
           (grammar-fail "ONE-OF requires a nonempty string: ~S" form))
         (make-instance 'lx-one-of-expr :source form :items (second form)))
        (:not-one-of
         (unless (and (= (length form) 2)
                      (or (and (stringp (second form))
                               (plusp (length (second form))))
                          (and (consp (second form))
                               (every (lambda (item)
                                        (or (characterp item)
                                            (and (consp item)
                                                 (characterp (car item))
                                                 (characterp (cdr item))
                                                 (char<= (car item) (cdr item)))))
                                      (second form)))))
           (grammar-fail "NOT-ONE-OF requires characters or ranges: ~S" form))
         (make-instance 'lx-not-one-of-expr :source form :items (second form)))
        (:any
         (unless (= (length form) 1)
           (grammar-fail "ANY takes no arguments: ~S" form))
         (make-instance 'lx-any-expr :source form))))))

(defgeneric lx-validate (expression definitions visiting))
(defmethod lx-validate ((expression lx-expr) definitions visiting)
  (declare (ignore definitions visiting)))
(defmethod lx-validate ((expression lx-reference-expr) definitions visiting)
  (let ((name (lx-expr-name expression)))
    (unless (gethash name definitions)
      (grammar-fail "Undefined lexer rule ~S" name))
    (when (member name visiting)
      (grammar-fail "Recursive lexer rule ~S" name))
    (lx-validate (gethash name definitions) definitions (cons name visiting))))
(defmethod lx-validate ((expression lx-sequence-expr) definitions visiting)
  (mapc (lambda (part) (lx-validate part definitions visiting))
        (lx-expr-parts expression)))
(defmethod lx-validate ((expression lx-unary-expr) definitions visiting)
  (lx-validate (lx-expr-body expression) definitions visiting))

(defgeneric lx-has-nongreedy (expression definitions))
(defmethod lx-has-nongreedy ((expression lx-expr) definitions)
  (declare (ignore definitions)) nil)
(defmethod lx-has-nongreedy ((expression lx-reference-expr) definitions)
  (lx-has-nongreedy (gethash (lx-expr-name expression) definitions) definitions))
(defmethod lx-has-nongreedy ((expression lx-sequence-expr) definitions)
  (some (lambda (part) (lx-has-nongreedy part definitions))
        (lx-expr-parts expression)))
(defmethod lx-has-nongreedy ((expression lx-unary-expr) definitions)
  (lx-has-nongreedy (lx-expr-body expression) definitions))
(defmethod lx-has-nongreedy ((expression lx-lazy-optional-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-has-nongreedy ((expression lx-lazy-star-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-has-nongreedy ((expression lx-lazy-plus-expr) definitions)
  (declare (ignore definitions)) t)

(defgeneric lx-has-semantic (expression definitions))
(defmethod lx-has-semantic ((expression lx-expr) definitions)
  (declare (ignore definitions)) nil)
(defmethod lx-has-semantic ((expression lx-callback-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-has-semantic ((expression lx-reference-expr) definitions)
  (lx-has-semantic (gethash (lx-expr-name expression) definitions) definitions))
(defmethod lx-has-semantic ((expression lx-sequence-expr) definitions)
  (some (lambda (part) (lx-has-semantic part definitions))
        (lx-expr-parts expression)))
(defmethod lx-has-semantic ((expression lx-unary-expr) definitions)
  (lx-has-semantic (lx-expr-body expression) definitions))

(defgeneric lx-nullable (expression definitions))
(defmethod lx-nullable ((expression lx-expr) definitions)
  (declare (ignore definitions)) nil)
(defmethod lx-nullable ((expression lx-reference-expr) definitions)
  (lx-nullable (gethash (lx-expr-name expression) definitions) definitions))
(defmethod lx-nullable ((expression lx-literal-expr) definitions)
  (declare (ignore definitions)) (zerop (length (lx-expr-text expression))))
(defmethod lx-nullable ((expression lx-callback-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-nullable ((expression lx-sequence-expr) definitions)
  (every (lambda (part) (lx-nullable part definitions))
         (lx-expr-parts expression)))
(defmethod lx-nullable ((expression lx-choice-expr) definitions)
  (some (lambda (part) (lx-nullable part definitions))
        (lx-expr-parts expression)))
(defmethod lx-nullable ((expression lx-optional-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-nullable ((expression lx-star-expr) definitions)
  (declare (ignore definitions)) t)
(defmethod lx-nullable ((expression lx-plus-expr) definitions)
  (lx-nullable (lx-expr-body expression) definitions))

(defgeneric lx-compile (expression definitions states entry exit))
(defmethod lx-compile ((expression lx-reference-expr) definitions states entry exit)
  (lx-compile (gethash (lx-expr-name expression) definitions)
              definitions states entry exit))
(defmethod lx-compile ((expression lx-literal-expr) definitions states entry exit)
  (declare (ignore definitions))
  (let ((text (lx-expr-text expression)) (current entry))
    (if (zerop (length text))
        (lx-edge states entry :epsilon exit)
        (loop for character across text
              for index from 0
              for next = (if (= index (1- (length text)))
                             exit (lx-new-state states))
              do (lx-edge states current :character next character)
                 (setf current next)))))
(defmethod lx-compile ((expression lx-range-expr) definitions states entry exit)
  (declare (ignore definitions))
  (lx-edge states entry :range exit
           (cons (lx-expr-lower expression) (lx-expr-upper expression))))
(defmethod lx-compile ((expression lx-one-of-expr) definitions states entry exit)
  (declare (ignore definitions))
  (lx-edge states entry :one-of exit (lx-expr-items expression)))
(defmethod lx-compile ((expression lx-not-one-of-expr) definitions states entry exit)
  (declare (ignore definitions))
  (lx-edge states entry :not-one-of exit (lx-expr-items expression)))
(defmethod lx-compile ((expression lx-any-expr) definitions states entry exit)
  (declare (ignore definitions))
  (lx-edge states entry :any exit))
(defmethod lx-compile ((expression lx-sequence-expr) definitions states entry exit)
  (let ((parts (lx-expr-parts expression)) (current entry))
    (if (null parts)
        (lx-edge states entry :epsilon exit)
        (loop for tail on parts
              for next = (if (null (rest tail)) exit (lx-new-state states))
              do (lx-compile (first tail) definitions states current next)
                 (setf current next)))))
(defmethod lx-compile ((expression lx-choice-expr) definitions states entry exit)
  (dolist (part (lx-expr-parts expression))
    (lx-compile part definitions states entry exit)))
(defmethod lx-compile ((expression lx-optional-expr) definitions states entry exit)
  (lx-edge states entry :epsilon exit)
  (lx-compile (lx-expr-body expression) definitions states entry exit))
(defmethod lx-compile ((expression lx-star-expr) definitions states entry exit)
  (let ((body-start (lx-new-state states)) (body-end (lx-new-state states)))
    (lx-edge states entry :epsilon exit)
    (lx-edge states entry :epsilon body-start)
    (lx-compile (lx-expr-body expression) definitions states body-start body-end)
    (lx-edge states body-end :epsilon body-start)
    (lx-edge states body-end :epsilon exit)))
(defmethod lx-compile ((expression lx-plus-expr) definitions states entry exit)
  (let ((middle (lx-new-state states)))
    (lx-compile (lx-expr-body expression) definitions states entry middle)
    (lx-compile (make-instance 'lx-star-expr :source (lx-expr-source expression)
                                           :body (lx-expr-body expression))
                definitions states middle exit)))

(defun lx-char-excluded-p (character items)
  (if (stringp items)
      (find character items)
      (some (lambda (item)
              (if (characterp item)
                  (char= character item)
                  (char<= (car item) character (cdr item))))
            items)))

(defgeneric lx-ordered-matcher (expression definitions))
(defmethod lx-ordered-matcher ((expression lx-reference-expr) definitions)
  (let ((matcher (lx-ordered-matcher
                  (gethash (lx-expr-name expression) definitions)
                  definitions)))
    (lambda (source at next)
      (let ((outer *lx-suppress-actions*))
        (let ((*lx-suppress-actions* t))
          (funcall matcher source at
                   (lambda (end)
                     (let ((*lx-suppress-actions* outer))
                       (funcall next end)))))))))
(defmethod lx-ordered-matcher ((expression lx-literal-expr) definitions)
  (declare (ignore definitions))
  (let ((literal (lx-expr-text expression)))
    (lambda (source at next)
      (let ((end (+ at (length literal))))
        (and (<= end (length source))
             (string= literal source :start2 at :end2 end)
             (funcall next end))))))
(defmethod lx-ordered-matcher ((expression lx-range-expr) definitions)
  (declare (ignore definitions))
  (let ((lower (lx-expr-lower expression)) (upper (lx-expr-upper expression)))
    (lambda (source at next)
      (and (< at (length source))
           (char<= lower (char source at) upper)
           (funcall next (1+ at))))))
(defmethod lx-ordered-matcher ((expression lx-one-of-expr) definitions)
  (declare (ignore definitions))
  (let ((items (lx-expr-items expression)))
    (lambda (source at next)
      (and (< at (length source))
           (find (char source at) items)
           (funcall next (1+ at))))))
(defmethod lx-ordered-matcher ((expression lx-not-one-of-expr) definitions)
  (declare (ignore definitions))
  (let ((items (lx-expr-items expression)))
    (lambda (source at next)
      (and (< at (length source))
           (not (lx-char-excluded-p (char source at) items))
           (funcall next (1+ at))))))
(defmethod lx-ordered-matcher ((expression lx-any-expr) definitions)
  (declare (ignore definitions))
  (lambda (source at next)
    (and (< at (length source)) (funcall next (1+ at)))))
(defmethod lx-ordered-matcher ((expression lx-predicate-expr) definitions)
  (declare (ignore definitions))
  (let ((callback (lx-expr-callback expression)))
    (lambda (source at next)
      (and (semantic-call callback source at) (funcall next at)))))
(defmethod lx-ordered-matcher ((expression lx-action-expr) definitions)
  (declare (ignore definitions))
  (let ((callback (lx-expr-callback expression)))
    (lambda (source at next)
      (let ((end (funcall next at)))
        (when (and end (not *lx-suppress-actions*))
          (push (cons callback at) *lx-action-events*))
        end))))
(defmethod lx-ordered-matcher ((expression lx-sequence-expr) definitions)
  (let ((parts (mapcar (lambda (part) (lx-ordered-matcher part definitions))
                       (lx-expr-parts expression))))
    (lambda (source at next)
      (labels ((match-parts (tail position)
                 (if (null tail)
                     (funcall next position)
                     (funcall (first tail) source position
                              (lambda (end) (match-parts (rest tail) end))))))
        (match-parts parts at)))))
(defmethod lx-ordered-matcher ((expression lx-choice-expr) definitions)
  (let ((parts (mapcar (lambda (part) (lx-ordered-matcher part definitions))
                       (lx-expr-parts expression))))
    (lambda (source at next)
      (if *lx-after-nongreedy*
          (some (lambda (part) (funcall part source at next)) parts)
          (let ((best nil) (best-events nil) (baseline *lx-action-events*))
            (dolist (part parts)
              (setf *lx-action-events* baseline)
              (let ((end (funcall part source at next)))
                (when (and end (or (null best) (> end best)))
                  (setf best end best-events *lx-action-events*))))
            (setf *lx-action-events* (if best best-events baseline))
            best)))))
(defun lx-repeat-matcher (body lazy-p)
  (lambda (source at next)
    (labels ((repeat (position)
               (flet ((more ()
                        (funcall body source position
                                 (lambda (end)
                                   (and (> end position) (repeat end))))))
                 (if lazy-p
                     (let ((*lx-after-nongreedy* t))
                       (or (funcall next position) (more)))
                     (or (more) (funcall next position))))))
      (repeat at))))
(defmethod lx-ordered-matcher ((expression lx-optional-expr) definitions)
  (let ((body (lx-ordered-matcher (lx-expr-body expression) definitions)))
    (lambda (source at next)
      (or (funcall body source at next) (funcall next at)))))
(defmethod lx-ordered-matcher ((expression lx-lazy-optional-expr) definitions)
  (let ((body (lx-ordered-matcher (lx-expr-body expression) definitions)))
    (lambda (source at next)
      (let ((*lx-after-nongreedy* t))
        (or (funcall next at) (funcall body source at next))))))
(defmethod lx-ordered-matcher ((expression lx-star-expr) definitions)
  (lx-repeat-matcher
   (lx-ordered-matcher (lx-expr-body expression) definitions) nil))
(defmethod lx-ordered-matcher ((expression lx-lazy-star-expr) definitions)
  (lx-repeat-matcher
   (lx-ordered-matcher (lx-expr-body expression) definitions) t))
(defmethod lx-ordered-matcher ((expression lx-plus-expr) definitions)
  (let* ((body (lx-ordered-matcher (lx-expr-body expression) definitions))
         (repeat (lx-repeat-matcher body nil)))
    (lambda (source at next)
      (funcall body source at
               (lambda (end) (funcall repeat source end next))))))
(defmethod lx-ordered-matcher ((expression lx-lazy-plus-expr) definitions)
  (let* ((body (lx-ordered-matcher (lx-expr-body expression) definitions))
         (repeat (lx-repeat-matcher body t)))
    (lambda (source at next)
      (funcall body source at
               (lambda (end) (funcall repeat source end next))))))

(defun lx-compile-ordered-matcher (expression definitions)
  (let ((matcher (lx-ordered-matcher expression definitions)))
    (lambda (source position)
      (let ((*lx-after-nongreedy* nil) (*lx-action-events* nil))
        (let ((end (funcall matcher source position #'identity)))
          (values end *lx-action-events*))))))

(defun lx-closure (states seeds)
  (graph-closure
   seeds #'identity
   (lambda (id pending result)
     (push id result)
     (dolist (edge (lx-state-edges (aref states id)))
       (when (eq (lx-edge-kind edge) :epsilon)
         (push (lx-edge-target edge) pending)))
     (values pending result))
   :test 'eql))

(defun lx-step (states active character)
  (lx-closure
   states
   (loop for id in active
         nconc (loop for edge in (lx-state-edges (aref states id))
                      when (case (lx-edge-kind edge)
                             (:character (char= character (lx-edge-value edge)))
                             (:range (char<= (car (lx-edge-value edge)) character
                                              (cdr (lx-edge-value edge))))
                             (:one-of (find character (lx-edge-value edge)))
                             (:not-one-of
                              (not (if (stringp (lx-edge-value edge))
                                       (find character (lx-edge-value edge))
                                       (some (lambda (item)
                                               (if (characterp item)
                                                   (char= character item)
                                                   (char<= (car item) character
                                                            (cdr item))))
                                             (lx-edge-value edge)))))
                             (:any t))
                        collect (lx-edge-target edge)))))

(defun lx-best-accept (states active)
  (loop for id in active
        for accept = (lx-state-accept (aref states id))
        when accept collect accept into matches
        finally (return (and matches (apply #'min matches)))))

(defun lx-make-dfa-state (states active)
  (make-lx-dfa-state :active active
                     :best-rule (lx-best-accept states active)))

(defun lx-next-dfa-state (states cache current character locked-p)
  (let ((code (char-code character)))
    (flet ((compute ()
             (cache-get-or-compute
              cache (flat-cache-key code (lx-dfa-state-active current))
              (lambda ()
                (lx-make-dfa-state
                 states (lx-step states
                                 (lx-dfa-state-active current)
                                 character))))))
      (if (< code 128)
          (flet ((ascii-next ()
                   (let ((edges (lx-dfa-state-edges current)))
                     (or (and edges (aref (the simple-vector edges) code))
                         (let ((next (compute)))
                           (unless edges
                             (setf edges (make-array 128 :initial-element nil)
                                   (lx-dfa-state-edges current) edges))
                           (setf (aref (the simple-vector edges) code) next))))))
            (if locked-p
                (bt:with-lock-held ((lx-dfa-state-lock current))
                  (ascii-next))
                (ascii-next)))
          (compute)))))

(defun initialize-compiled-lexer (lexer)
  "Bind a compiled lexer's runtime functions to its own transition cache."
  (let ((states (compiled-lexer-states lexer))
        (mode-starts (compiled-lexer-mode-starts lexer))
        (kinds (compiled-lexer-kinds lexer))
        (skips (compiled-lexer-skips lexer))
        (channels (compiled-lexer-channels lexer))
        (push-modes (compiled-lexer-push-modes lexer))
        (pop-modes (compiled-lexer-pop-modes lexer))
        (set-modes (compiled-lexer-set-modes lexer))
        (ordered-rules (compiled-lexer-ordered-rules lexer))
        (cache (compiled-lexer-cache lexer))
        (locked-p (typep (compiled-lexer-cache lexer) 'locked-cache)))
    (declare (type simple-vector kinds skips channels push-modes pop-modes
                   set-modes))
    (labels ((match-one (source position mode)
               (declare (type string source) (type fixnum position))
               (let ((dfa (cache-get-or-compute
                           cache mode
                           (lambda ()
                             (lx-make-dfa-state
                              states
                              (lx-closure states
                                          (list (gethash mode mode-starts)))))))
                     (best-end nil) (best-rule nil) (best-actions nil))
                 (loop for offset of-type fixnum from position below (length source) do
                   (setf dfa (lx-next-dfa-state
                              states cache dfa (char source offset) locked-p))
                   (when (null (lx-dfa-state-active dfa)) (return))
                   (let ((rule (lx-dfa-state-best-rule dfa)))
                     (when rule
                       (setf best-end (1+ offset) best-rule rule))))
                 (dolist (entry ordered-rules)
                   (destructuring-bind (rule-mode rule-index matcher) entry
                     (when (eq rule-mode mode)
                       (multiple-value-bind (end actions)
                           (funcall matcher source position)
                         (when (and end (> end position)
                                    (or (null best-end) (> end best-end)
                                        (and (= end best-end)
                                             (< rule-index best-rule))))
                           (setf best-end end best-rule rule-index
                                 best-actions actions))))))
                 (dolist (event best-actions)
                   (semantic-call (car event) source (cdr event)))
                 (values (and best-rule (aref kinds best-rule))
                         best-end best-rule))))
      (setf (compiled-lexer-matcher lexer) #'match-one
            (compiled-lexer-function lexer)
            (lambda (source)
              (unless (stringp source)
                (error 'type-error :datum source :expected-type 'string))
              (let ((position 0) (output nil) (mode :default) (mode-stack nil))
                (declare (type string source) (type fixnum position))
                (loop while (< position (length source)) do
                  (multiple-value-bind (kind best-end best-rule)
                      (match-one source position mode)
                    (unless best-end
                      (error 'lexical-error :position position
                             :character (char source position)))
                    (unless (aref skips best-rule)
                      (push (make-lexeme :kind kind
                                         :source source
                                         :start position :end best-end
                                         :channel (aref channels best-rule))
                            output))
                    (cond ((aref push-modes best-rule)
                           (push mode mode-stack)
                           (setf mode (aref push-modes best-rule)))
                          ((aref pop-modes best-rule)
                           (unless mode-stack
                             (error 'lexer-mode-error :position position
                                    :character (char source position) :mode mode))
                           (setf mode (pop mode-stack)))
                          ((aref set-modes best-rule)
                           (setf mode (aref set-modes best-rule))))
                    (setf position best-end)))
                (coerce (nreverse output) 'vector)))))
    lexer))

(defun compile-lexer (definitions &key (cache-backend :hash-table) metadata)
  "Compile Lisp-form lexer rules into an inspectable lexer object.
Rules are (kind expression &key skip channel mode push-mode pop-mode set-mode).
MODE selects the active mode for a rule, defaulting to :DEFAULT. A matched
rule may change modes, including when it is skipped. The longest match wins;
ties use rule order among rules in the current mode. The second return value
is a matcher taking (source position mode), returning kind, end, and rule
index for one token without consuming the rest of the source.
CACHE-BACKEND selects :FSET, :HASH-TABLE, a custom backend, or
(:LOCKED backend). The default is :HASH-TABLE."
  (unless (and (listp definitions) definitions)
    (grammar-fail "Expected a nonempty list of lexer rules"))
  (let ((patterns (make-hash-table :test 'eq))
        (states (make-array 0 :adjustable t :fill-pointer 0))
        (mode-starts (make-hash-table :test 'eq))
        (kinds nil)
        (skips nil)
        (channels nil)
        (push-modes nil)
        (pop-modes nil)
        (set-modes nil)
        (ordered-rules nil))
    (dolist (definition definitions)
      (unless (and (consp definition)
                   (>= (length definition) 2)
                   (evenp (length definition))
                   (symbolp (first definition))
                   (loop with seen = nil
                         for (key value) on (cddr definition) by #'cddr
                         always (and (member key '(:skip :channel :mode
                                                   :push-mode :pop-mode
                                                   :set-mode))
                                     (not (member key seen))
                                     (prog1
                                         (case key
                                           ((:skip :pop-mode)
                                            (member value '(nil t)))
                                           (otherwise
                                            (and (symbolp value) value)))
                                       (push key seen)))))
        (grammar-fail "Invalid lexer rule or options: ~S"
                      definition))
      (let* ((options (cddr definition))
             (actions (count-if (lambda (key) (plist-key-p options key))
                                '(:push-mode :pop-mode :set-mode))))
        (when (> actions 1)
          (grammar-fail "Lexer rule ~S has more than one mode action"
                        (first definition)))
        (when (and (plist-key-p options :pop-mode)
                   (not (eq (getf options :pop-mode) t)))
          (grammar-fail ":POP-MODE must be T in lexer rule ~S"
                        (first definition))))
      (when (gethash (first definition) patterns)
        (grammar-fail "Duplicate lexer rule ~S" (first definition)))
      (setf (gethash (first definition) patterns)
            (lx-expression-from-form (second definition)))
      (let ((mode (getf (cddr definition) :mode :default)))
        (unless (gethash mode mode-starts)
          (setf (gethash mode mode-starts) (lx-new-state states)))))
    (unless (gethash :default mode-starts)
      (grammar-fail "A lexer needs at least one rule in :DEFAULT mode"))
    (dolist (definition definitions)
      (lx-validate (gethash (first definition) patterns)
                   patterns (list (first definition)))
      (when (lx-nullable (gethash (first definition) patterns) patterns)
        (grammar-fail "Lexer rules must consume at least one character"))
      (dolist (key '(:push-mode :set-mode))
        (when (and (plist-key-p (cddr definition) key)
                   (not (gethash (getf (cddr definition) key) mode-starts)))
          (grammar-fail "Lexer rule ~S targets undefined mode ~S"
                        (first definition) (getf (cddr definition) key)))))
    (loop for definition in definitions for index from 0 do
      (if (or (lx-has-nongreedy (gethash (first definition) patterns) patterns)
              (lx-has-semantic (gethash (first definition) patterns) patterns))
          (push (list (getf (cddr definition) :mode :default)
                      index (lx-compile-ordered-matcher
                             (gethash (first definition) patterns) patterns))
                ordered-rules)
          (let ((entry (lx-new-state states))
                (exit (lx-new-state states)))
            (lx-edge states (gethash (getf (cddr definition) :mode :default)
                                     mode-starts)
                     :epsilon entry)
            (lx-compile (gethash (first definition) patterns)
                        patterns states entry exit)
            (setf (lx-state-accept (aref states exit)) index)))
        (push (first definition) kinds)
        (push (getf (cddr definition) :skip) skips)
        (push (getf (cddr definition) :channel :default) channels)
        (push (getf (cddr definition) :push-mode) push-modes)
        (push (getf (cddr definition) :pop-mode) pop-modes)
        (push (getf (cddr definition) :set-mode) set-modes))
    (setf kinds (coerce (nreverse kinds) 'vector)
          skips (coerce (nreverse skips) 'vector)
          channels (coerce (nreverse channels) 'vector)
          push-modes (coerce (nreverse push-modes) 'vector)
          pop-modes (coerce (nreverse pop-modes) 'vector)
          set-modes (coerce (nreverse set-modes) 'vector))
    (maphash (lambda (mode start)
               (declare (ignore mode))
               (when (lx-best-accept states (lx-closure states (list start)))
                 (grammar-fail "Lexer rules must consume at least one character")))
             mode-starts)
    (let ((lexer (make-compiled-lexer
                  :states states :mode-starts mode-starts :kinds kinds
                  :ordered-rules (nreverse ordered-rules)
                  :metadata metadata
                  :skips skips :channels channels :push-modes push-modes
                  :pop-modes pop-modes :set-modes set-modes
                  :cache-backend cache-backend :cache (make-cache cache-backend))))
      (initialize-compiled-lexer lexer)
      (values lexer (compiled-lexer-matcher lexer)))))
